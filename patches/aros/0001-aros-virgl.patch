+        unsigned capacity=cb->resource_capacity?cb->resource_capacity*2:32;
+        struct virgl_hw_res **array=avgl_native_grow(cb->resources,(size_t)cb->resource_capacity*sizeof(*array),(size_t)capacity*sizeof(*array));
