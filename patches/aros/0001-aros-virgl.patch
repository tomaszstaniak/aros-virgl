diff --git a/developer/debug/test/library/qualinventory.c b/developer/debug/test/library/qualinventory.c
new file mode 100644
index 0000000000..bcc1912650
--- /dev/null
+++ b/developer/debug/test/library/qualinventory.c
@@ -0,0 +1,36 @@
+/* Non-invasive loaded-library snapshot for local qualification only. */
+#include <exec/execbase.h>
+#include <exec/libraries.h>
+#include <dos/dos.h>
+#include <utility/tagitem.h>
+#include <libraries/debug.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/debug.h>
+struct entry { APTR base,vector; ULONG version,revision,refs; char id[256]; };
+static void copy_text(char *to,CONST_STRPTR from,unsigned limit)
+{ unsigned i=0; if(from)while(i+1<limit && from[i]){to[i]=(char)from[i];i++;}to[i]=0; }
+int main(void)
+{
+    const char *names[]={"debug.library","fd.library","stdc.library","stdcio.library","posixc.library","z1.library","gallium.library","gallium.hidd","softpipe.hidd","virgl.hidd","mesa3dgl26-2.library","crtretain.library"};
+    struct entry rows[12]={{0}}; unsigned i;
+    /* Snapshot without opening/closing any inspected library. No output or
+       allocations while holding the scheduler lock. */
+    Forbid();
+    for(i=0;i<12;i++) {
+        struct Library *root=(void *)FindName(&SysBase->LibList,names[i]);
+        if(!root)continue;
+        rows[i].base=root;rows[i].vector=__AROS_GETVECADDR(root,1);
+        rows[i].version=root->lib_Version;rows[i].revision=root->lib_Revision;rows[i].refs=root->lib_OpenCnt;
+        copy_text(rows[i].id,root->lib_IdString,sizeof(rows[i].id));
+    }
+    Permit();
+    for(i=0;i<12;i++) {
+        if(!rows[i].base){FPrintf(Output(),"%s absent\n",names[i]);continue;}
+        CONST_STRPTR module=NULL;
+        struct TagItem tags[]={{DL_ModuleName,(IPTR)&module},{TAG_DONE,0}};
+        DecodeLocationA(rows[i].vector,tags);
+        FPrintf(Output(),"%s base=%p version=%lu.%lu refs=%lu module=%s id=%s\n",names[i],rows[i].base,rows[i].version,rows[i].revision,rows[i].refs,module?module:(CONST_STRPTR)"unknown",rows[i].id);
+    }
+    Flush(Output());return 0;
+}
diff --git a/developer/debug/test/library/qualmodexpunge.c b/developer/debug/test/library/qualmodexpunge.c
new file mode 100644
index 0000000000..3a195319cb
--- /dev/null
+++ b/developer/debug/test/library/qualmodexpunge.c
@@ -0,0 +1,25 @@
+/* Copyright (C) 2026, The AROS Development Team. All rights reserved. */
+/* Qualification-only targeted expunge; no global memory pressure. */
+#include <exec/execbase.h>
+#include <exec/libraries.h>
+#include <dos/dos.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+int main(int argc,char **argv)
+{
+    if(argc!=2)return 20;
+    Forbid();BOOL existed=FindName(&SysBase->LibList,argv[1])!=NULL;Permit();
+    if(!existed){FPrintf(Output(),"target not resident: %s\n",argv[1]);return 20;}
+    struct Library *owned=OpenLibrary(argv[1],0);if(!owned)return 20;
+    Forbid();
+    struct Library *root=(void *)FindName(&SysBase->LibList,argv[1]);
+    ULONG refs=root?root->lib_OpenCnt:0;
+    Permit();
+    BOOL eligible=root && refs==1;
+    /* Our opening pins the root while RemLibrary marks delayed expunge. */
+    if(eligible)RemLibrary(root);
+    CloseLibrary(owned);
+    Forbid();BOOL remains=FindName(&SysBase->LibList,argv[1])!=NULL;Permit();
+    FPrintf(Output(),"targeted expunge: %s refs_with_own_pin=%lu remains=%ld\n",argv[1],refs,(LONG)remains);
+    Flush(Output());return eligible && !remains?0:5;
+}
diff --git a/developer/debug/test/library/stdciohandlecheck.c b/developer/debug/test/library/stdciohandlecheck.c
new file mode 100644
index 0000000000..90298be892
--- /dev/null
+++ b/developer/debug/test/library/stdciohandlecheck.c
@@ -0,0 +1,66 @@
+/* Regression for upstream AROS #2028: close must not restore foreign handles. */
+#include <exec/tasks.h>
+#include <exec/libraries.h>
+#include <dos/dos.h>
+#include <dos/dosextens.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#define MODE_BITS 0x0cUL
+struct check {
+    BPTR input,output,other_input,other_output;
+    ULONG in_before,out_before,in_after,out_after;
+    ULONG child_id;
+    LONG rc;
+    BOOL replace;
+    volatile unsigned done;
+};
+static LONG child_entry(void)
+{
+    struct check *c=FindTask(NULL)->tc_UserData;
+    struct Library *stdio;
+    struct FileHandle *in=BADDR(c->input),*out=BADDR(c->output);
+    c->child_id=GetETask(FindTask(NULL))->et_UniqueID;
+    c->in_before=in->fh_Flags;c->out_before=out->fh_Flags;
+    stdio=OpenLibrary("stdcio.library",0);
+    if(!stdio){c->rc=20;__atomic_store_n(&c->done,1,__ATOMIC_RELEASE);return 20;}
+    in->fh_Flags ^= 8;out->fh_Flags ^= 8;
+    if(c->replace){SelectInput(c->other_input);SelectOutput(c->other_output);}
+    CloseLibrary(stdio);
+    c->in_after=in->fh_Flags;c->out_after=out->fh_Flags;
+    c->rc=((c->in_after&MODE_BITS)==((c->in_before^(c->replace?8:0))&MODE_BITS) &&
+           (c->out_after&MODE_BITS)==((c->out_before^(c->replace?8:0))&MODE_BITS))?0:5;
+    /* The parent still owns these live NIL handles. Restore the test's mode
+       change explicitly before parent disposal; do not touch other flag bits. */
+    in->fh_Flags=(in->fh_Flags&~MODE_BITS)|(c->in_before&MODE_BITS);
+    out->fh_Flags=(out->fh_Flags&~MODE_BITS)|(c->out_before&MODE_BITS);
+    SelectInput(c->input);SelectOutput(c->output);
+    __atomic_store_n(&c->done,1,__ATOMIC_RELEASE);
+    return c->rc;
+}
+int main(void)
+{
+    unsigned mode,repeat;LONG failures=0;
+    for(mode=0;mode<2;mode++)for(repeat=0;repeat<3;repeat++){
+        struct check c={0};struct Process *p;
+        c.replace=mode;
+        c.input=Open("NIL:",MODE_OLDFILE);c.output=Open("NIL:",MODE_NEWFILE);
+        c.other_input=Open("NIL:",MODE_OLDFILE);c.other_output=Open("NIL:",MODE_NEWFILE);
+        if(!c.input || !c.output || !c.other_input || !c.other_output)c.rc=20;
+        else {
+            p=CreateNewProcTags(NP_Entry,(IPTR)child_entry,NP_Name,(IPTR)"stdcio-own-handle-check",
+                NP_StackSize,1000000,NP_UserData,(IPTR)&c,NP_Input,c.input,NP_Output,c.output,
+                NP_CloseInput,FALSE,NP_CloseOutput,FALSE,TAG_DONE);
+            if(!p)c.rc=20;
+            else {
+                while(!__atomic_load_n(&c.done,__ATOMIC_ACQUIRE))Delay(1);
+                while(ChildStatus(c.child_id)==CHILD_ACTIVE)Delay(1);
+            }
+        }
+        FPrintf(Output(),"%s repeat=%lu input=%lx->%lx output=%lx->%lx rc=%ld\n",
+            mode?"foreign":"owned",(ULONG)repeat,c.in_before,c.in_after,c.out_before,c.out_after,c.rc);
+        if(c.rc)failures++;
+        if(c.other_output)Close(c.other_output);if(c.other_input)Close(c.other_input);
+        if(c.output)Close(c.output);if(c.input)Close(c.input);
+    }
+    FPrintf(Output(),"stdcio handles: failures=%ld\n",failures);Flush(Output());return failures?5:0;
+}
