diff --git a/compiler/pthread/module_hooks.h b/compiler/pthread/module_hooks.h
new file mode 100644
index 0000000000..737de0c3ab
--- /dev/null
+++ b/compiler/pthread/module_hooks.h
@@ -0,0 +1,14 @@
+/* Optional module-local hooks, for pthread copies in pertask libraries.
+ * The creator keeps the owning module alive through join. Enter runs before
+ * any module CRT call; leave follows TLS destruction. Detached workers are
+ * unsupported for these module copies because their code must remain pinned
+ * until the native process has returned. Ordinary program copies are unchanged. */
+#ifndef AROS_PTHREAD_MODULE_HOOKS_H
+#define AROS_PTHREAD_MODULE_HOOKS_H
+extern void *__aros_pthread_module_capture(void) __attribute__((weak));
+extern int __aros_pthread_module_enter(void *parent_base) __attribute__((weak));
+extern void __aros_pthread_module_leave(void) __attribute__((weak));
+extern void **__aros_pthread_module_tls_values(int create) __attribute__((weak));
+extern void **__aros_pthread_module_allocate_tls(void);
+extern void __aros_pthread_module_cleanup_tls(void **values);
+#endif
diff --git a/compiler/pthread/module_runtime.c b/compiler/pthread/module_runtime.c
new file mode 100644
index 0000000000..94e4abbcfe
--- /dev/null
+++ b/compiler/pthread/module_runtime.c
@@ -0,0 +1,116 @@
+/* Explicitly compiled into a pertaskbase,norootrellibs module, never into
+ * the generic libpthread archive. Each copy owns its root-only StdC base and
+ * worker openings. The embedding private base supplies APTR pthread_tlsvalues;
+ * root TLS stays outside that copied template. No PosixC or standard handles
+ * are retained by the root. */
+#include <exec/libraries.h>
+#include <exec/memory.h>
+#include <proto/exec.h>
+#include <proto/task.h>
+#include <proto/stdc.h>
+#include <aros/symbolsets.h>
+#include LC_LIBDEFS_FILE
+#include "module_hooks.h"
+
+/* Optional state inheritance within one joined worker family. Preparation
+ * runs in the creator before worker creation; inheritance precedes user CRT. */
+extern void __aros_module_worker_prepare(void) __attribute__((weak));
+extern int __aros_module_worker_inherit(void *) __attribute__((weak));
+static struct Library *module_stdc;
+static CONST_STRPTR module_name;
+static LONG worker_slot;
+static LIBBASETYPEPTR module_root;
+static void **root_tlsvalues;
+
+/* A root and every duplicate own independent TLS, not a disappearing task slot. */
+void **__aros_pthread_module_tls_values(int create)
+{
+    LIBBASETYPEPTR base=(void *)__aros_getoffsettable();
+    if(!base)return NULL;
+    /* LLVM emutls ignores pthread_setspecific failure. Provision the vector
+     * before opening user code, so storing a value cannot fail halfway. */
+    (void)create;
+    return base==module_root?root_tlsvalues:base->pthread_tlsvalues;
+}
+static int ModuleClientOpen(LIBBASETYPEPTR base)
+{
+    base->pthread_tlsvalues=__aros_pthread_module_allocate_tls();
+    return base->pthread_tlsvalues!=NULL;
+}
+ADD2OPENLIB(ModuleClientOpen,-100);
+
+static void ModuleClientClose(LIBBASETYPEPTR base)
+{
+    void **values=base==module_root?root_tlsvalues:base->pthread_tlsvalues;
+    if(values){
+        __aros_pthread_module_cleanup_tls(values);
+        if(base==module_root)root_tlsvalues=NULL;
+        else base->pthread_tlsvalues=NULL;
+        FreeVec(values);
+    }
+}
+/* Before logger FILEs and relative client CRT disappear. */
+ADD2CLOSELIB(ModuleClientClose,100);
+static int ModuleRuntimeInit(void)
+{
+    struct Library *root = (struct Library *)__aros_getoffsettable();
+    module_root=(void *)root;
+    /* Keep root TLS outside the copied template, including during failed OPEN. */
+    root_tlsvalues=module_root->pthread_tlsvalues;
+    module_root->pthread_tlsvalues=NULL;
+    struct Library **slot = (struct Library **)
+        ((char *)root + AROS_RELLIB_OFFSET_STDC);
+    worker_slot = AllocTaskStorageSlot();
+    if (worker_slot <= 0) return FALSE;
+    module_name = root->lib_Node.ln_Name;
+    module_stdc = OpenLibrary("stdc.library", 0);
+    *slot = module_stdc;
+    if (!module_stdc) return FALSE;
+    if (!root_tlsvalues) root_tlsvalues=__aros_pthread_module_allocate_tls();
+    return root_tlsvalues != NULL;
+}
+static void ModuleRuntimeExit(void)
+{
+    /* Runs after pthread EXIT joined every worker and after user exit hooks. */
+    ModuleClientClose((void *)__aros_getoffsettable());
+    if (module_stdc) {
+        struct Library **slot = (struct Library **)
+            (__aros_getoffsettable() + AROS_RELLIB_OFFSET_STDC);
+        struct Library *owned = module_stdc;
+        module_stdc = NULL;
+        *slot = NULL;
+        CloseLibrary(owned);
+    }
+    if (worker_slot > 0) {
+        FreeTaskStorageSlot(worker_slot);
+        worker_slot = 0;
+    }
+    module_name = NULL;
+    module_root = NULL;
+}
+void *__aros_pthread_module_capture(void)
+{
+    if (__aros_module_worker_prepare) __aros_module_worker_prepare();
+    return __aros_getoffsettable();
+}
+int __aros_pthread_module_enter(void *parent_base)
+{
+    struct Library *owned;
+    if (!module_name || worker_slot <= 0) return -1;
+    owned = OpenLibrary(module_name, 0);
+    if (!owned) return -1;
+    if ((__aros_module_worker_inherit && __aros_module_worker_inherit(parent_base)) ||
+        !SetTaskStorageSlot(worker_slot, (IPTR)owned)) {
+        CloseLibrary(owned);
+        return -1;
+    }
+    return 0;
+}
+void __aros_pthread_module_leave(void)
+{
+    struct Library *owned = (struct Library *)GetTaskStorageSlot(worker_slot);
+    SetTaskStorageSlot(worker_slot, 0);
+    if (owned) CloseLibrary(owned);
+}
+ADD2INIT(ModuleRuntimeInit, -100);
+ADD2EXIT(ModuleRuntimeExit, -100);
