+++ b/developer/debug/test/library/crtretainprobe.c
@@ -0,0 +1,164 @@
+/* Native diagnostics are independent of the stdio write being tested. */
+#include <exec/libraries.h>
+#include <dos/dosextens.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <libraries/posixc.h>
+#define __CRTRETAIN_NOLIBBASE__
+#include <proto/crtretain.h>
+#include <proto/gallium.h>
+#include <gallium/gallium.h>
+#include <gallium/screenfactory.h>
+#include <hidd/gallium.h>
+#include <proto/posixc.h>
+#include <aros/types/file_s.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <errno.h>
+
+struct Library *CrtretainBase, *GalliumBase;
+
+/* Synchronous test callbacks live until main returns. Production factory
+ * callbacks live in the module named by factory.module. */
+static int creates, destroys;
+static APTR test_create(struct Library *module, ULONG backend, APTR winsys)
+{ ++creates; return (APTR)1; }
+static APTR test_create_fail(struct Library *module, ULONG backend, APTR winsys)
+{ ++creates; return NULL; }
+static void test_destroy(struct Library *module, APTR screen)
+{ if (screen == (APTR)1) ++destroys; }
+static ULONG test_stride(struct Library *module, ULONG format, ULONG width)
+{ return width * 4; }
+static int factory_test(void)
+{
+    struct Library *module = OpenLibrary("mesa3dgl26-2.library", 0);
+    struct GalliumScreenFactory factory = {
+        .version = GALLIUM_SCREEN_FACTORY_VERSION, .size = sizeof(factory),
+        .backends = GALLIUM_SCREEN_BACKEND_SOFTPIPE, .module = module,
+        .create = test_create, .destroy = test_destroy, .stride = test_stride
+    };
+    struct Library missing = {0};
+    struct TagItem tags[] = {
+        {CPS_GalliumInterfaceVersion, GALLIUM_INTERFACE_VERSION},
+        {CPS_PipeScreenFactory, (IPTR)&factory}, {TAG_DONE, 0}
+    };
+    PipeHandle_t pipe;
+    PipeScreen_t screen;
+    ULONG before;
+    int errors = 0;
+    creates = destroys = 0;
+    if (!module) return 1;
+    before = module->lib_OpenCnt;
+    missing.lib_Node.ln_Name = "qual-nonexistent-provider.library";
+    factory.module = &missing;
+    pipe = CreatePipe(tags);
+    if (pipe) { ++errors; DestroyPipe(pipe); }
+    factory.module = module;
+    factory.version = 0;
+    pipe = CreatePipe(tags);
+    if (pipe) { ++errors; DestroyPipe(pipe); }
+    factory.version = GALLIUM_SCREEN_FACTORY_VERSION;
+    factory.backends = 0;
+    pipe = CreatePipeV(tags);
+    if (pipe) { ++errors; DestroyPipe(pipe); }
+    factory.backends = GALLIUM_SCREEN_BACKEND_SOFTPIPE;
+    factory.create = test_create_fail;
+    pipe = CreatePipe(tags);
+    if (!pipe) ++errors;
+    else {
+        if (CreatePipeScreen(pipe)) ++errors;
+        DestroyPipe(pipe);
+    }
+    factory.create = test_create;
+    pipe = CreatePipe(tags);
+    if (!pipe) ++errors;
+    else {
+        screen = CreatePipeScreen(pipe);
+        if (screen != (APTR)1) ++errors;
+        DestroyPipeScreen(pipe, screen);
+        DestroyPipeScreen(pipe, screen);
+        DestroyPipe(pipe);
+    }
+    pipe = CreatePipe(tags);
+    if (!pipe) ++errors;
+    else { CreatePipeScreen(pipe); DestroyPipe(pipe); }
+    if (creates != 3 || destroys != 2 || module->lib_OpenCnt != before) ++errors;
+    FPrintf(Output(), "factory: errors=%ld creates=%ld destroys=%ld before=%lu after=%lu\n",
+        (LONG)errors, (LONG)creates, (LONG)destroys, before, (ULONG)module->lib_OpenCnt);
+    CloseLibrary(module);
+    return errors;
+}
+
+int main(int argc, char **argv)
+{
+    int worker = argc > 1 && (!strcmp(argv[1], "worker-tls-fail") || !strcmp(argv[1], "client-tls") || !strcmp(argv[1], "worker") || !strcmp(argv[1], "worker-fail") || !strcmp(argv[1], "worker-log") || !strcmp(argv[1], "worker-log-parallel") || !strcmp(argv[1], "worker-log-nested") || !strcmp(argv[1], "worker-exit"));
+    int factory_mode = argc > 1 && !strcmp(argv[1], "factory");
+    int closed = argc > 1 && !strcmp(argv[1], "closed");
+    int control = argc > 1 && !strcmp(argv[1], "control");
+    int mesa = argc > 1 && !strcmp(argv[1], "mesa");
+    int softpipe = argc > 1 && !strcmp(argv[1], "softpipe");
+    int gallium = factory_mode || closed || (argc > 1 && !strcmp(argv[1], "gallium"));
+    const char *token = argc > 2 ? argv[2] : "manual";
+    struct Library *owner = control ? NULL : OpenLibrary(mesa ? "mesa3dgl26-2.library" :
+        softpipe ? "softpipe.hidd" : gallium ? "gallium.library" : "crtretain.library", 0);
+    struct Process *process = (struct Process *)FindTask(NULL);
+    PipeHandle_t pipe = NULL;
+    APTR retained = NULL;
+    BPTR handle = 0;
+    int mapped, written, flushed;
+    if (!control && !owner) return 20;
+    CrtretainBase = owner;
+    if (factory_mode) {
+        GalliumBase = owner;
+        if (factory_test()) { CloseLibrary(owner); return 10; }
+    }
+    if (gallium)
+    {
+        struct TagItem tags[] = {
+            { CPS_GalliumInterfaceVersion, GALLIUM_INTERFACE_VERSION },
+            { TAG_DONE, 0 }
+        };
+        GalliumBase = owner;
+        pipe = CreatePipe(tags);
+        if (!pipe) { CloseLibrary(owner); return 20; }
+    }
+    /* Diagnostic only: the pinned Mesa/HIDD layouts end in relative CRT slots. */
+    if (mesa || (softpipe && owner->lib_Revision < 3))
+        retained = *(APTR *)((char *)owner + owner->lib_PosSize - 2 * sizeof(APTR));
+    else if (!control && !gallium && !softpipe)
+        retained = RetainedPosixC();
+    mapped = __get_default_file(1, (long *)&handle);
+    FPrintf(Output(), "retain: task=%p returnaddr=%p owner=%p owner_count=%lu retained=%p client=%p output=%p pipe=%p\n",
+        process, process->pr_ReturnAddr, owner, owner ? (ULONG)owner->lib_OpenCnt : 0,
+        retained, __aros_getbase_PosixCBase(), (APTR)Output(), pipe);
+    FPrintf(Output(), "routing: fd1=%p output=%p mapped=%ld result=%s\n",
+        (APTR)handle, (APTR)Output(), (LONG)mapped,
+        mapped == 0 && handle == Output() ? "PASS" : "FAIL");
+    Flush(Output());
+    if (closed) {
+        int shut = close(1);
+        written = printf("STDIO_CLIENT[%s]\n", token);
+        flushed = fflush(stdout);
+        FPrintf(Output(), "closed: result=%s close=%ld written=%ld flush=%ld\n",
+            shut == 0 && (written < 0 || flushed != 0) ? "PASS" : "FAIL",
+            (LONG)shut, (LONG)written, (LONG)flushed);
+        if (pipe) DestroyPipe(pipe);
+        if (owner) CloseLibrary(owner);
+        return shut == 0 && (written < 0 || flushed != 0) ? 0 : 10;
+    }
+    if (worker) {
+        int error = WriteWorkerMarker(token);
+        FPrintf(Output(), "worker: error=%ld\n", (LONG)error);
+        written = error ? -1 : 1;
+        flushed = error ? -1 : 0;
+    } else {
+        written = printf("STDIO_CLIENT[%s]\n", token);
+        flushed = fflush(stdout);
+    }
+    FPrintf(Output(), "stdio: written=%ld flush=%ld\n", (LONG)written, (LONG)flushed);
+    Flush(Output());
+    if (pipe) DestroyPipe(pipe);
+    if (owner) CloseLibrary(owner);
+    return mapped == 0 && handle == Output() && written > 0 && flushed == 0 ? 0 : 10;
+}
diff --git a/developer/debug/test/library/mesaalloctest.c b/developer/debug/test/library/mesaalloctest.c
new file mode 100644
index 0000000000..8ffb46e9a6
--- /dev/null
+++ b/developer/debug/test/library/mesaalloctest.c
@@ -0,0 +1,75 @@
+/* Regression for Mesa's Exec allocator versus CRT allocating functions.
+ * Large blocks make retained allocations distinguishable from normal pool
+ * bookkeeping. Compare within one process, before its CRT pool is destroyed. */
+#define _GNU_SOURCE
+#include <proto/exec.h>
+#include <exec/memory.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdarg.h>
+#include <errno.h>
+
+#define BLOCK (1024 * 1024)
+static int use_vasprintf(char **out, const char *format, ...)
+{
+    int result;
+    va_list args;
+    va_start(args, format);
+    result = vasprintf(out, format, args);
+    va_end(args);
+    return result;
+}
+int main(void)
+{
+    char *source = malloc(BLOCK + 1), *copy;
+    IPTR before, after;
+    void *memory;
+    int i, errors = 0;
+    if (!source) return 20;
+    memset(source, 'x', BLOCK); source[BLOCK] = 0;
+    printf("allocator: starting allocation families\n"); fflush(stdout);
+    before = AvailMem(MEMF_ANY);
+    for (i = 0; i < 4; ++i) {
+        copy = strdup(source);
+        if (!copy || strlen(copy) != BLOCK || copy[BLOCK - 1] != 'x') ++errors;
+        free(copy);
+        copy = strndup(source, BLOCK / 2);
+        if (!copy || strlen(copy) != BLOCK / 2) ++errors;
+        free(copy);
+        copy = NULL;
+        if (asprintf(&copy, "[%s]", source) != BLOCK + 2 || !copy || copy[0] != '[') ++errors;
+        free(copy);
+        copy = NULL;
+        if (use_vasprintf(&copy, "{%s}", source) != BLOCK + 2 || !copy || copy[0] != '{') ++errors;
+        free(copy);
+        memory = aligned_alloc(64, BLOCK);
+        if (!memory || (uintptr_t)memory % 64) ++errors;
+        if (memory) memset(memory, 0xa5, BLOCK);
+        void *original = memory;
+        memory = realloc(original, BLOCK + 64);
+        if (!memory) { ++errors; free(original); }
+        else {
+            if (((unsigned char *)memory)[BLOCK - 1] != 0xa5) ++errors;
+            free(memory);
+        }
+    }
+    after = AvailMem(MEMF_ANY);
+    printf("allocator: before=%ld after=%ld retained=%ld\n", (long)before, (long)after, (long)(before - after));
+    if (before - after > 262144) ++errors;
+    /* Match the existing AROS extension for a non-multiple size. */
+    memory = aligned_alloc(64, 17);
+    if (!memory || (uintptr_t)memory % 64) ++errors;
+    if (memory) memset(memory, 0x5a, 17);
+    free(memory);
+    memory = malloc((size_t)UINT32_MAX);
+    if (memory) { ++errors; free(memory); }
+    memory = calloc(SIZE_MAX / 2 + 1, 2);
+    if (memory) { ++errors; free(memory); }
+    memory = aligned_alloc(0, 64);
+    if (memory) { ++errors; free(memory); }
+    free(source);
+    printf("allocator: errors=%d %s\n", errors, errors ? "FAIL" : "PASS");
+    return errors ? 10 : 0;
+}
