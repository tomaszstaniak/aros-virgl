--- /dev/null
+++ b/developer/debug/test/hidds/virtio-gpu/virglpaircheck.c
@@ -0,0 +1,172 @@
+/* Copyright (C) 2026, The AROS Development Team. All rights reserved. */
+/* Two independent RunCommand processes. Keep B's renderer live until A has
+ * completely exited, then require B to draw/read again before its own exit. */
+#include <exec/execbase.h>
+#include <exec/tasks.h>
+#include <exec/libraries.h>
+#include <dos/dosextens.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <stdio.h>
+#include <string.h>
+#include "virglpair_protocol.h"
+
+struct job {
+    BPTR segment, output;
+    char arguments[256], path[512];
+    ULONG argument_length, child_id;
+    LONG rc;
+    BOOL started, created;
+};
+static LONG child_entry(void)
+{
+    struct job *job = FindTask(NULL)->tc_UserData;
+    /* Publish our own ID; the returned Process pointer can already be stale
+     * if a fast child exits before CreateNewProc returns to the parent. */
+    job->child_id = GetETask(FindTask(NULL))->et_UniqueID;
+    __atomic_store_n(&job->started, TRUE, __ATOMIC_RELEASE);
+    /* No parent CRT calls: this process enters the loaded child's own CRT. */
+    job->rc = RunCommand(job->segment, 4000000, job->arguments, job->argument_length);
+    return job->rc;
+}
+static UWORD library_count(CONST_STRPTR name)
+{
+    struct Library *base;
+    UWORD count = 0;
+    Forbid();
+    base = (struct Library *)FindName(&SysBase->LibList, name);
+    if (base) count = base->lib_OpenCnt;
+    Permit();
+    return count;
+}
+static BOOL active(struct job *job)
+{ return __atomic_load_n(&job->started, __ATOMIC_ACQUIRE) && ChildStatus(job->child_id) == CHILD_ACTIVE; }
+static BOOL pending(struct job *job)
+{ return job->created && (!__atomic_load_n(&job->started, __ATOMIC_ACQUIRE) || active(job)); }
+static void collect_ready(struct MsgPort *port, struct avgl_pair_ready **ready, BOOL *okay)
+{
+    struct Message *message;
+    while ((message = GetMsg(port)) != NULL) {
+        struct avgl_pair_ready *r = (struct avgl_pair_ready *)message;
+        if (message->mn_Length != sizeof(*r) || r->role > 1 || ready[r->role]) {
+            *okay = FALSE; ReplyMsg(message);
+        } else ready[r->role] = r;
+    }
+}
+static int occurrences(const char *text, const char *marker)
+{
+    int count = 0;
+    while ((text = strstr(text, marker)) != NULL) { count++; text++; }
+    return count;
+}
+int main(int argc, char **argv)
+{
+    struct job jobs[2] = {{0}};
+    struct avgl_pair_ready *ready[2] = {0};
+    struct MsgPort *port = NULL;
+    char port_name[64], data[16384];
+    BOOL okay = TRUE;
+    UWORD before = library_count("posixc.library");
+    struct Library *held_gallium;
+    BOOL cold = argc == 4 && !strcmp(argv[3], "cold");
+    unsigned i, ticks;
+    if (argc != 3 && !cold) { puts("Usage: virglpaircheck child log-prefix [cold]"); return 10; }
+    /* Prevent legitimate library GC from removing the cached provider before
+     * its reference count is inspected. Opening Gallium does not load it. */
+    held_gallium = OpenLibrary("gallium.library", 26);
+    if (!held_gallium) return 10;
+    UWORD provider_before = library_count("virgl.hidd");
+    printf("loaded gallium: %u.%u; provider pins before clients=%u\n",
+        held_gallium->lib_Version, held_gallium->lib_Revision, provider_before);
+    if (cold && (held_gallium->lib_Version != 26 || held_gallium->lib_Revision != 2 || provider_before)) {
+        puts("FAIL: cold fallback setup/version"); CloseLibrary(held_gallium); return 10;
+    }
+    snprintf(port_name, sizeof(port_name), "virgl-pair-%p", FindTask(NULL));
+    port = CreateMsgPort();
+    if (!port) { CloseLibrary(held_gallium); return 10; }
+    port->mp_Node.ln_Name = port_name;
+    Forbid();
+    if (FindPort(port_name)) { Permit(); DeleteMsgPort(port); CloseLibrary(held_gallium); return 10; }
+    AddPort(port); Permit();
+    for (i = 0; i < 2; i++) {
+        struct Process *child;
+        BPTR input;
+        int length = snprintf(jobs[i].path, sizeof(jobs[i].path), "%s-%u.log", argv[2], i);
+        if (length < 0 || (unsigned)length >= sizeof(jobs[i].path)) { okay = FALSE; break; }
+        length = snprintf(jobs[i].arguments, sizeof(jobs[i].arguments),
+            "virgl single handles logerror=%u pairport=%s pairrole=%u\n", 70+i, port_name, i);
+        if (length < 0 || (unsigned)length >= sizeof(jobs[i].arguments)) { okay = FALSE; break; }
+        jobs[i].argument_length = length;
+        jobs[i].rc = 10;
+        jobs[i].segment = LoadSeg(argv[1]);
+        jobs[i].output = Open(jobs[i].path, MODE_NEWFILE);
+        input = Open("NIL:", MODE_OLDFILE);
+        if (!jobs[i].segment || !jobs[i].output || !input) {
+            if (input) Close(input);
+            okay = FALSE; break;
+        }
+        child = CreateNewProcTags(NP_Entry, (IPTR)child_entry,
+            NP_Name, (IPTR)"VirGL pair client", NP_Cli, TRUE,
+            NP_UserData, (IPTR)&jobs[i], NP_StackSize, 131072,
+            NP_Input, input, NP_CloseInput, TRUE,
+            NP_Output, jobs[i].output, NP_CloseOutput, FALSE,
+            NP_Error, jobs[i].output, NP_CloseError, FALSE,
+            NP_NotifyOnDeath, TRUE, TAG_DONE);
+        if (!child) { Close(input); okay = FALSE; break; }
+        jobs[i].created = TRUE;
+    }
+    for (ticks = 0; okay && (!ready[0] || !ready[1]); ticks++) {
+        collect_ready(port, ready, &okay);
+        if ((!pending(&jobs[0]) || !pending(&jobs[1])) || ticks >= 6000) okay = FALSE;
+        if (!ready[0] || !ready[1]) Delay(1);
+    }
+    if (okay) {
+        puts("both renderer contexts are live: PASS"); fflush(stdout);
+        ReplyMsg(&ready[0]->message); ready[0] = NULL;
+        ChildWait(jobs[0].child_id);
+        printf("first client exited: rc=%ld; releasing surviving client\n", (long)jobs[0].rc);
+        fflush(stdout);
+        ReplyMsg(&ready[1]->message); ready[1] = NULL;
+    } else {
+        puts("FAIL: both clients did not reach the live-context barrier"); fflush(stdout);
+    }
+    /* On partial startup/failure, release any late readiness messages, and
+     * keep this entry code, job records and seglists alive through child death. */
+    while (pending(&jobs[0]) || pending(&jobs[1])) {
+        if (!okay) {
+            collect_ready(port, ready, &okay);
+            for (i = 0; i < 2; i++) if (ready[i]) {
+                ReplyMsg(&ready[i]->message); ready[i] = NULL;
+            }
+        }
+        Delay(1);
+    }
+    for (i = 0; i < 2; i++) {
+        if (jobs[i].started) { ChildWait(jobs[i].child_id); ChildFree(jobs[i].child_id); }
+        if (jobs[i].segment) UnLoadSeg(jobs[i].segment);
+        if (jobs[i].output) {
+            LONG length;
+            Flush(jobs[i].output); Seek(jobs[i].output, 0, OFFSET_BEGINNING);
+            length = Read(jobs[i].output, data, sizeof(data)-1);
+            if (length < 0) length = 0;
+            data[length] = 0;
+            char own[64], other[64], survivor[64];
+            snprintf(own, sizeof(own), "STDIO_CLIENT[logging-client-%02u]", 70+i);
+            snprintf(other, sizeof(other), "STDIO_CLIENT[logging-client-%02u]", 71-i);
+            snprintf(survivor, sizeof(survivor), "pair survivor: role=%u PASS", i);
+            if (jobs[i].rc || occurrences(data, own) != 1 || occurrences(data, other) ||
+                !strstr(data, survivor) || !strstr(data, "\nPASS\n")) okay = FALSE;
+            Close(jobs[i].output);
+        } else okay = FALSE;
+        printf("client%u rc=%ld\n", i, (long)jobs[i].rc);
+    }
+    RemPort(port); DeleteMsgPort(port);
+    UWORD provider_after = library_count("virgl.hidd");
+    printf("provider pins after both clients=%u expected=1\n", provider_after);
+    if (provider_after != 1) okay = FALSE;
+    CloseLibrary(held_gallium);
+    UWORD after = library_count("posixc.library");
+    if (after != before) okay = FALSE;
+    printf("pair stdio/ownership: PosixC %u->%u %s\n", before, after, okay ? "PASS" : "FAIL");
+    return okay ? 0 : 10;
+}
diff --git a/developer/debug/test/hidds/virtio-gpu/virglrunprobe.c b/developer/debug/test/hidds/virtio-gpu/virglrunprobe.c
new file mode 100644
index 0000000000..c1526914ae
--- /dev/null
+++ b/developer/debug/test/hidds/virtio-gpu/virglrunprobe.c
@@ -0,0 +1,89 @@
+/* Copyright (C) 2026, The AROS Development Team. All rights reserved. */
+/* Diagnostic launcher: compare RunCommand with/without task-storage scope.
+ * No GL dependency. Child logs and return values must both be inspected.
+ */
+#include <proto/dos.h>
+#include <proto/exec.h>
+#include <proto/task.h>
+#include <stdio.h>
+#include <string.h>
+
+APTR TaskResBase;
+
+int main(int argc, char **argv)
+{
+    const char args[] = "softpipe openonly\n";
+    BPTR report = Output();
+    BPTR outputs[10] = {0};
+    LONG slot;
+    int scoped, n, result = RETURN_OK;
+
+    if (argc != 4 || (strcmp(argv[1], "scoped") && strcmp(argv[1], "plain")))
+    {
+        FPrintf(report, "Usage: virglrunprobe scoped|plain child log-prefix\n");
+        return RETURN_FAIL;
+    }
+    scoped = !strcmp(argv[1], "scoped");
+    TaskResBase = OpenResource("task.resource");
+    if (!TaskResBase) return RETURN_FAIL;
+    /* Make storage nonempty, so NULL from SaveTaskStorage means failure. */
+    slot = AllocTaskStorageSlot();
+    if (slot <= 0) return RETURN_FAIL;
+    if (!SetTaskStorageSlot(slot, 123))
+    {
+        FreeTaskStorageSlot(slot);
+        return RETURN_FAIL;
+    }
+    for (n = 1; n <= 10; ++n)
+    {
+        char path[512];
+        BPTR seg, output, previous;
+        APTR saved = NULL;
+        LONG rc;
+        if (snprintf(path, sizeof(path), "%s-%d.log", argv[3], n) >= (int)sizeof(path))
+        { result = RETURN_FAIL; break; }
+        seg = LoadSeg(argv[2]);
+        if (!seg) { result = RETURN_FAIL; break; }
+        output = Open(path, MODE_NEWFILE);
+        if (!output) { UnLoadSeg(seg); result = RETURN_FAIL; break; }
+        if (scoped)
+        {
+            saved = SaveTaskStorage();
+            if (!saved)
+            { Close(output); UnLoadSeg(seg); result = RETURN_FAIL; break; }
+        }
+        FPrintf(report, "child %ld scoped=%ld output=%p start\n", (LONG)n, (LONG)scoped, output);
+        Flush(report);
+        previous = SelectOutput(output);
+        rc = RunCommand(seg, 262144, args, sizeof(args) - 1);
+        if (scoped) RestoreTaskStorage(saved);
+        SelectOutput(previous);
+        Flush(output);
+        outputs[n-1] = output; /* Keep handles distinct across invocations. */
+        UnLoadSeg(seg);
+        FPrintf(report, "child %ld rc=%ld slot=%ld\n", (LONG)n, rc, GetTaskStorageSlot(slot));
+        Flush(report);
+        if (rc != RETURN_OK || GetTaskStorageSlot(slot) != 123)
+        { result = RETURN_FAIL; break; }
+    }
+    for (n = 0; n < 10; ++n)
+    {
+        char data[4096], *match;
+        LONG len;
+        int passes = 0;
+        if (!outputs[n]) { result = RETURN_FAIL; continue; }
+        Seek(outputs[n], 0, OFFSET_BEGINNING);
+        len = Read(outputs[n], data, sizeof(data) - 1);
+        if (len < 0) len = 0;
+        data[len] = 0;
+        match = data;
+        while ((match = strstr(match, "openonly: PASS\n")) != NULL)
+        { ++passes; ++match; }
+        FPrintf(report, "log %ld passes=%ld\n", (LONG)n + 1, (LONG)passes);
+        if (passes != 1) result = RETURN_FAIL;
+        Close(outputs[n]);
+    }
+    FreeTaskStorageSlot(slot);
+    FPrintf(report, "runner result=%ld\n", (LONG)result);
+    return result;
+}
diff --git a/developer/debug/test/hidds/virtio-gpu/virgltransport_fixture.h b/developer/debug/test/hidds/virtio-gpu/virgltransport_fixture.h
new file mode 100644
index 0000000000..0491b5111d
--- /dev/null
+++ b/developer/debug/test/hidds/virtio-gpu/virgltransport_fixture.h
@@ -0,0 +1,253 @@
+/* Shared deterministic transport fixture; all substitutions are local. */
+#ifndef AROS_VIRGL_TRANSPORT_FIXTURE_H
+#define AROS_VIRGL_TRANSPORT_FIXTURE_H
+/* Copyright (C) 2026, The AROS Development Team. All rights reserved. */
+/* Execute the actual native transport with a deterministic PCI/queue fixture.
+ * No physical hardware, real PCI attributes or global Exec hooks are touched. */
+#include <exec/memory.h>
+#include <dos/dos.h>
+#include <utility/hooks.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/oop.h>
+#include <proto/utility.h>
+#include <aros/debug.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../../../../workbench/hidds/virgl/virgl_transport.h"
+#include "../../crt/test.h"
+#ifdef VIRGL_WINSYS_FIXTURE
+#include "../../../../../workbench/hidds/virgl/virgl_winsys_aros.h"
+#include "pipe/p_state.h"
+#endif
+
+#define FIXTURE_DMA_BYTES (8192 + 512*1024 + 8192)
+struct tracked { APTR p; BOOL pci; ULONG bytes,generation; };
+static struct tracked blocks[128];
+struct dma_registration { APTR p; ULONG length,flags; };
+static struct dma_registration registrations[4];
+static UBYTE pci_config[256];
+static union { UQUAD alignment; UBYTE bytes[512]; } bar;
+static APTR queue_dma;
+static ULONG attempts, fail_allocation, live, wrong_free;
+static ULONG allocation_generation,last_pci_generation,command_count[0x220];
+static ULONG claims, mappings, attributes, objects, resets, completed;
+static ULONG pre_attempts, fail_pre, short_pre, active_pre, bad_post, reject_type;
+static ULONG reject_followup;
+static BOOL fail_reset, drop_completion, reject_next, fail_object, fail_claim, bad_address, missing_device;
+static UWORD observed_avail, selected_queue;
+static struct avgl_manager manager;
+static int pci_object, gpu_object, pci_driver;
+extern OOP_AttrBase HiddPCIDeviceAttrBase;
+
+static APTR real_alloc(ULONG bytes) { return AllocVec(bytes, MEMF_ANY|MEMF_CLEAR); }
+static void real_free(APTR p) { FreeVec(p); }
+static APTR fixture_allocate(ULONG bytes, BOOL pci, BOOL clear)
+{
+    unsigned i;
+    if (++attempts == fail_allocation) return NULL;
+    for(i=0;i<128 && blocks[i].p;i++);
+    if(i==128)return NULL;
+    blocks[i].p=real_alloc(bytes);blocks[i].pci=pci;blocks[i].bytes=bytes;
+    blocks[i].generation=++allocation_generation;
+    if(blocks[i].p && !clear)memset(blocks[i].p,0xa5,bytes);
+    if(blocks[i].p)live++;
+    return blocks[i].p;
+}
+static void fixture_free(APTR p,BOOL pci)
+{
+    unsigned i;
+    if(!p)return;
+    for(i=0;i<128 && blocks[i].p!=p;i++);
+    if(i==128 || blocks[i].pci!=pci){wrong_free++;return;}
+    for(unsigned j=0;j<4;j++)if(registrations[j].p &&
+        (IPTR)registrations[j].p >= (IPTR)p &&
+        (IPTR)registrations[j].p < (IPTR)p+blocks[i].bytes){wrong_free++;return;}
+    if(p==queue_dma)queue_dma=NULL;
+    real_free(p);blocks[i].p=NULL;live--;
+}
+static APTR fixture_vec(ULONG bytes,ULONG flags)
+{ return fixture_allocate(bytes,FALSE,(flags&MEMF_CLEAR)!=0); }
+static APTR fixture_pci(ULONG bytes)
+{
+    APTR p=fixture_allocate(bytes,TRUE,FALSE);
+    if(p)for(unsigned i=0;i<128;i++)if(blocks[i].p==p)last_pci_generation=blocks[i].generation;
+    if(p && bytes==FIXTURE_DMA_BYTES && !queue_dma)queue_dma=p;
+    return p;
+}
+static APTR fixture_pre(APTR p,ULONG *bytes,ULONG flags)
+{
+    (void)bytes;(void)flags;
+    if(++pre_attempts==fail_pre)return NULL;
+    if(pre_attempts==short_pre)*bytes/=2;
+    for(unsigned i=0;i<4;i++)if(!registrations[i].p){
+        registrations[i]=(struct dma_registration){p,*bytes,flags};active_pre++;return p;
+    }
+    bad_post++;return NULL;
+}
+static void fixture_post(APTR p,ULONG *bytes,ULONG flags)
+{
+    volatile struct virtio_pci_common_cfg *common=(APTR)bar.bytes;
+    if(drop_completion && common->device_status)bad_post++;
+    for(unsigned i=0;i<4;i++)if(registrations[i].p==p &&
+        registrations[i].length==*bytes && registrations[i].flags==flags){
+        registrations[i].p=NULL;active_pre--;return;
+    }
+    bad_post++;
+}
+static void fixture_barrier(void)
+{
+    volatile struct virtio_pci_common_cfg *common=(APTR)bar.bytes;
+    if(!common->device_status){
+        resets++;
+        if(fail_reset)common->device_status=1;
+        else {common->queue_enable=0;selected_queue=0xffff;return;}
+    }
+    if(selected_queue!=common->queue_select){
+        selected_queue=common->queue_select;common->queue_enable=0;common->queue_size=8;
+    }
+    if(!queue_dma || drop_completion)return;
+    volatile struct virtq_avail *avail=(APTR)((UBYTE*)queue_dma+256);
+    volatile struct virtq_used *used=(APTR)((UBYTE*)queue_dma+512);
+    if(avail->idx==observed_avail)return;
+    observed_avail=avail->idx;
+    struct gpu_header *req=(APTR)((UBYTE*)queue_dma+8192);
+    struct gpu_header *resp=(APTR)((UBYTE*)queue_dma+8192+512*1024);
+    if(req->type<0x220)command_count[req->type]++;
+    ULONG size=sizeof(*resp);
+    memset(resp,0,8192);resp->flags=req->flags;resp->fence=req->fence;resp->context=req->context;
+    if(reject_next && (!reject_type || req->type==reject_type)){
+        resp->type=GPU_ERR_INVALID_PARAMETER;reject_next=reject_followup!=0;
+        reject_type=reject_followup;reject_followup=0;
+    }
+    else if(req->type==GPU_GET_CAPSET_INFO){
+        struct capset_info *info=(APTR)resp;
+        resp->type=GPU_OK_CAPSET_INFO;info->id=1;info->version=1;info->size=16;size=sizeof(*info);
+    } else if(req->type==GPU_GET_CAPSET){resp->type=GPU_OK_CAPSET;size+=16;}
+    else resp->type=GPU_OK_NODATA;
+    used->ring[used->idx%8].id=0;used->ring[used->idx%8].len=size;used->idx++;completed++;
+}
+static ULONG fixture_read_long(ULONG offset)
+{ ULONG v;CopyMem(pci_config+offset,&v,sizeof(v));return v; }
+static IPTR fixture_attr(OOP_AttrID id)
+{
+    ULONG offset=id-HiddPCIDeviceAttrBase;
+    if(offset==aoHidd_PCIDevice_VendorID)return VIRTIO_PCI_VENDOR_ID;
+    if(offset==aoHidd_PCIDevice_ProductID)return 0x1050;
+    if(offset==aoHidd_PCIDevice_Class)return 3;
+    if(offset==aoHidd_PCIDevice_SubClass)return 0x80;
+    if(offset==aoHidd_PCIDevice_Driver)return (IPTR)&pci_driver;
+    if(offset==aoHidd_PCIDevice_Base0)return 0x100000;
+    if(offset==aoHidd_PCIDevice_Size0)return sizeof(bar);
+    return 0;
+}
+static void fixture_enum(struct Hook *h)
+{
+    if(missing_device)return;
+    AROS_UFC3(void,h->h_Entry,
+        AROS_UFCA(struct Hook*,h,A0),AROS_UFCA(OOP_Object*,(OOP_Object*)&gpu_object,A2),AROS_UFCA(APTR,NULL,A1));
+}
+static APTR fixture_object(void)
+{ if(fail_object)return NULL;objects++;return &pci_object; }
+static APTR fixture_claim(void)
+{ if(fail_claim)return "fixture busy";claims++;return NULL; }
+
+/* These are local compile-time substitutions, after the real SDK headers.
+ * Production function bodies below are included verbatim, without mock forks. */
+#undef AllocVec
+#undef FreeVec
+#undef CachePreDMA
+#undef CachePostDMA
+#undef Delay
+#undef SetSignal
+#undef OOP_GetAttr
+#undef OOP_NewObject
+#undef OOP_DisposeObject
+#undef OOP_ObtainAttrBase
+#undef OOP_ReleaseAttrBase
+#undef HIDD_PCI_EnumDevices
+#undef HIDD_PCIDevice_ReadConfigByte
+#undef HIDD_PCIDevice_ReadConfigLong
+#undef HIDD_PCIDevice_ReadConfigWord
+#undef HIDD_PCIDevice_WriteConfigWord
+#undef HIDD_PCIDevice_Obtain
+#undef HIDD_PCIDevice_Release
+#undef HIDD_PCIDriver_MapPCI
+#undef HIDD_PCIDriver_UnmapPCI
+#undef HIDD_PCIDriver_CPUtoPCI
+#undef HIDD_PCIDriver_AllocPCIMem
+#undef HIDD_PCIDriver_FreePCIMem
+#define AllocVec(bytes,flags) fixture_vec(bytes,flags)
+#define FreeVec(p) fixture_free(p,FALSE)
+#undef SetMem
+#define SetMem(p,value,bytes) ((void)UtilityBase,(void)memset(p,value,bytes))
+#define CachePreDMA(p,len,flags) fixture_pre(p,len,flags)
+#define CachePostDMA(p,len,flags) fixture_post(p,len,flags)
+#define Delay(ticks) ((void)(ticks))
+#define SetSignal(new,mask) 0
+#define __sync_synchronize() fixture_barrier()
+#define OOP_GetAttr(object,id,out) ((void)(object),*(out)=fixture_attr(id))
+#define OOP_NewObject(cl,id,tags) fixture_object()
+#define OOP_DisposeObject(object) ((void)(object),objects--)
+#define OOP_ObtainAttrBase(id) (attributes++,0x1000)
+#define OOP_ReleaseAttrBase(id) (attributes--)
+#define HIDD_PCI_EnumDevices(pci,hook,requirements) ((void)(pci),(void)(requirements),fixture_enum(hook))
+#define HIDD_PCIDevice_ReadConfigByte(device,offset) pci_config[offset]
+#define HIDD_PCIDevice_ReadConfigLong(device,offset) fixture_read_long(offset)
+#define HIDD_PCIDevice_ReadConfigWord(device,offset) ((UWORD)0)
+#define HIDD_PCIDevice_WriteConfigWord(device,offset,value) ((void)(value))
+#define HIDD_PCIDevice_Obtain(device,name) fixture_claim()
+#define HIDD_PCIDevice_Release(device) (claims--)
+#define HIDD_PCIDriver_MapPCI(driver,address,size) (mappings++,(APTR)bar.bytes)
+#define HIDD_PCIDriver_UnmapPCI(driver,address,size) (mappings--)
+#define HIDD_PCIDriver_CPUtoPCI(driver,p) ((void)(driver),bad_address ? (APTR)-1 : (p))
+#define HIDD_PCIDriver_AllocPCIMem(driver,size) fixture_pci(size)
+#define HIDD_PCIDriver_FreePCIMem(driver,p) fixture_free(p,TRUE)
+#include "../../../../../workbench/hidds/virgl/virgl_native.h"
+#include "../../../../../workbench/hidds/virgl/virgl_transport.c"
+
+static void config_long(ULONG offset,ULONG value)
+{ CopyMem(&value,pci_config+offset,sizeof(value)); }
+static void fixture_init(void)
+{
+    memset(&manager,0,sizeof(manager));memset(blocks,0,sizeof(blocks));
+    memset(&bar,0,sizeof(bar));memset(pci_config,0,sizeof(pci_config));
+    attempts=fail_allocation=live=wrong_free=claims=mappings=attributes=objects=resets=completed=0;
+    allocation_generation=last_pci_generation=reject_followup=0;
+    memset(command_count,0,sizeof(command_count));
+    pre_attempts=fail_pre=short_pre=active_pre=bad_post=reject_type=0;queue_dma=NULL;
+    memset(registrations,0,sizeof(registrations));
+    fail_reset=drop_completion=reject_next=fail_object=fail_claim=bad_address=FALSE;
+    missing_device=FALSE;
+    observed_avail=0;selected_queue=0xffff;
+    volatile struct virtio_pci_common_cfg *common=(APTR)bar.bytes;
+    common->device_feature=1;common->num_queues=2;common->queue_size=8;
+    config_long(0x10,0x100000);pci_config[0x34]=0x40;
+    unsigned i;const UBYTE cap[]={0x40,0x50,0x64,0x74};
+    const ULONG offsets[]={0,0x100,0x110,0x120};
+    const ULONG sizes[]={sizeof(*common),2,1,16};
+    for(i=0;i<4;i++){
+        ULONG c=cap[i];pci_config[c]=VIRTIO_PCI_CAP_VENDOR_CFG;
+        pci_config[c+1]=i==3?0:cap[i+1];pci_config[c+2]=i==1?20:16;pci_config[c+3]=i+1;
+        config_long(c+8,offsets[i]);config_long(c+12,sizes[i]);
+    }
+    config_long(0x50+16,2);
+    ULONG cap_count=1;CopyMem(&cap_count,bar.bytes+0x120+12,sizeof(cap_count));
+    avgl_manager_init(&manager,NULL);
+}
+static inline BOOL fixture_generation_live(ULONG generation)
+{
+    for(unsigned i=0;i<128;i++)if(blocks[i].p && blocks[i].generation==generation)return TRUE;
+    return FALSE;
+}
+void cleanup(void)
+{
+    /* Fixture-only simulated reboot: clear hardware faults, then reclaim the
+     * still-root-owned quarantine. This is not a production recovery API. */
+    fail_reset=drop_completion=FALSE;
+    if(manager.device){device_close(manager.device);fixture_free(manager.device,FALSE);manager.device=NULL;}
+    for(unsigned i=0;i<128;i++)if(blocks[i].p){real_free(blocks[i].p);blocks[i].p=NULL;}
+}
+
+#endif
diff --git a/developer/debug/test/hidds/virtio-gpu/virgltransporttest.c b/developer/debug/test/hidds/virtio-gpu/virgltransporttest.c
new file mode 100644
index 0000000000..8323410d3c
--- /dev/null
+++ b/developer/debug/test/hidds/virtio-gpu/virgltransporttest.c
@@ -0,0 +1,118 @@
+/* Copyright (C) 2026, The AROS Development Team. All rights reserved. */
+#include "virgltransport_fixture.h"
+
+static int shared_lifetime(void)
+{
+    struct avgl_transport a,b;ULONG got;
+    struct gpu_header req={.type=GPU_CTX_ATTACH_RESOURCE};
+    fixture_init();TEST(avgl_open(&a,&manager));TEST(avgl_open(&b,&manager));
+    TEST(a.context!=b.context && a.context && b.context);TEST(claims==1 && objects==1);
+    TEST(avgl_resource_id(&a)==1);TEST(avgl_resource_id(&b)==2);
+    ULONG before=resets;TEST(avgl_close(&a));TEST(resets==before && claims==1);
+    TEST(avgl_command(&b,&req,sizeof(req),GPU_OK_NODATA,sizeof(req),&got,TRUE));
+    TEST(avgl_close(&b));TEST(!live && !claims && !mappings && !objects && !attributes && !wrong_free);
+    TEST(avgl_manager_can_expunge(&manager));return OK;
+}
+static int failed_acquisitions(void)
+{
+    for(unsigned n=0;n<3;n++){
+        struct avgl_transport a;fixture_init();
+        volatile struct virtio_pci_common_cfg *common=(APTR)bar.bytes;
+        if(n==0)missing_device=TRUE;
+        else if(n==1)common->device_feature=0;
+        else {ULONG count=0;CopyMem(&count,bar.bytes+0x120+12,sizeof(count));}
+        TEST(!avgl_open(&a,&manager));
+        TEST(!manager.device && !live && !claims && !objects && !attributes && !mappings && !wrong_free);
+    }
+    for(unsigned n=1;n<=5;n++){
+        struct avgl_transport a;fixture_init();fail_allocation=n;
+        if(avgl_open(&a,&manager)){TEST(avgl_close(&a));}
+        TEST(!manager.device && !live && !claims && !objects && !attributes && !mappings && !wrong_free);
+    }
+    for(unsigned n=0;n<2;n++){
+        struct avgl_transport a;fixture_init();fail_object=n==0;fail_claim=n==1;
+        TEST(!avgl_open(&a,&manager));TEST(!manager.device && !live && !claims && !objects && !attributes);
+    }
+    for(unsigned n=1;n<=2;n++){
+        struct avgl_transport a;fixture_init();TEST(avgl_open(&a,&manager));
+        ULONG baseline=live;fail_allocation=attempts+n;
+        TEST(!avgl_alloc(&a,4096));TEST(live==baseline && !wrong_free);
+        fail_allocation=0;APTR p=avgl_alloc(&a,4096);TEST(p!=NULL);avgl_free(&a,p);
+        TEST(live==baseline);TEST(avgl_close(&a));TEST(!live && !wrong_free);
+    }
+    return OK;
+}
+static int rejection_and_exhaustion(void)
+{
+    struct avgl_transport a,b,c;ULONG got;
+    struct gpu_header req={.type=GPU_CTX_ATTACH_RESOURCE};
+    fixture_init();TEST(avgl_open(&a,&manager));TEST(avgl_open(&b,&manager));
+    reject_next=TRUE;reject_type=GPU_CTX_CREATE;ULONG initial_resets=resets;
+    TEST(!avgl_open(&c,&manager));TEST(manager.references==2 && resets==initial_resets);
+    reject_type=0;
+    reject_next=TRUE;ULONG before=resets;
+    TEST(!avgl_command(&a,&req,sizeof(req),GPU_OK_NODATA,sizeof(req),&got,TRUE));
+    TEST(avgl_healthy(&b));TEST(avgl_command(&b,&req,sizeof(req),GPU_OK_NODATA,sizeof(req),&got,TRUE));
+    TEST(resets==before);
+    manager.device->next_context=~(ULONG)0;TEST(!avgl_open(&c,&manager));TEST(manager.references==2);
+    manager.device->next_resource=~(ULONG)0;TEST(!avgl_resource_id(&b));
+    manager.device->fence=~(UQUAD)0;before=completed;
+    TEST(!avgl_command(&b,&req,sizeof(req),GPU_OK_NODATA,sizeof(req),&got,TRUE));TEST(completed==before);
+    TEST(avgl_close(&a));TEST(avgl_close(&b));TEST(!live && !wrong_free);return OK;
+}
+static int timeout_quarantine(void)
+{
+    struct avgl_transport a,b;ULONG got;
+    struct gpu_header req={.type=GPU_CTX_ATTACH_RESOURCE};
+    fixture_init();TEST(avgl_open(&a,&manager));TEST(avgl_open(&b,&manager));
+    APTR backing=avgl_alloc(&a,4096);TEST(backing!=NULL);
+    ULONG baseline=live,before=resets;drop_completion=TRUE;
+    TEST(!avgl_command(&a,&req,sizeof(req),GPU_OK_NODATA,sizeof(req),&got,TRUE));
+    TEST(!avgl_healthy(&b));TEST(avgl_close(&a));TEST(resets==before && live==baseline);
+    fail_reset=TRUE;TEST(!avgl_close(&b));TEST(manager.device && !manager.references);
+    TEST(live==baseline && claims==1 && mappings==1 && attributes==1 && objects==1);
+    TEST(!avgl_manager_can_expunge(&manager));
+    TEST(active_pre==2 && !bad_post);
+    fail_reset=drop_completion=FALSE;TEST(device_close(manager.device));
+    fixture_free(manager.device,FALSE);manager.device=NULL;
+    TEST(!live && !claims && !mappings && !attributes && !objects && !wrong_free);
+    TEST(!active_pre && !bad_post);return OK;
+}
+static int cache_failure(void)
+{
+    for(unsigned n=1;n<=4;n++){
+        struct avgl_transport a;ULONG got;
+        struct gpu_header req={.type=GPU_CTX_ATTACH_RESOURCE};
+        fixture_init();TEST(avgl_open(&a,&manager));
+        if(n<=2)fail_pre=pre_attempts+n;else short_pre=pre_attempts+n-2;
+        ULONG before=completed;
+        TEST(!avgl_command(&a,&req,sizeof(req),GPU_OK_NODATA,sizeof(req),&got,TRUE));
+        TEST(completed==before);TEST(!active_pre && !bad_post);
+        TEST(avgl_healthy(&a));
+        TEST(avgl_close(&a));TEST(!live && !wrong_free);
+    }
+    return OK;
+}
+static int invalid_dma_address(void)
+{
+    struct avgl_transport a;ULONG got;
+    struct gpu_header req={.type=GPU_CTX_ATTACH_RESOURCE};
+    fixture_init();TEST(avgl_open(&a,&manager));bad_address=TRUE;ULONG before=completed;
+    TEST(!avgl_command(&a,&req,sizeof(req),GPU_OK_NODATA,sizeof(req),&got,TRUE));
+    TEST(completed==before && !active_pre && !bad_post);
+    bad_address=FALSE;TEST(avgl_healthy(&a));
+    TEST(avgl_command(&a,&req,sizeof(req),GPU_OK_NODATA,sizeof(req),&got,TRUE));
+    TEST(avgl_close(&a));TEST(!live && !wrong_free);return OK;
+}
+int main(void)
+{
+    int failed=0;
+    int (*cases[])(void)={shared_lifetime,failed_acquisitions,rejection_and_exhaustion,
+        timeout_quarantine,cache_failure,invalid_dma_address};
+    for(unsigned i=0;i<sizeof(cases)/sizeof(cases[0]);i++){
+        printf("transport fault case %u\n",i);fflush(stdout);
+        if(cases[i]()!=OK)failed++;
+    }
+    printf("transport fault cases: failures=%d\n",failed);
+    return failed?FAIL:OK;
+}
diff --git a/developer/debug/test/hidds/virtio-gpu/winsys/mmakefile.src b/developer/debug/test/hidds/virtio-gpu/winsys/mmakefile.src
