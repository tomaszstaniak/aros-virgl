+ * Workers borrow only those same-client streams; standard FILEs are not cached. */
+struct Mesa3DGLBase {
+    struct Library library;
+    /* Native vector belongs to this root/client/worker duplicate. */
+    APTR pthread_tlsvalues;
+    BOOL log_borrowed;
+    APTR log_file;
+    BOOL log_initialized;
+    APTR gallium_log_file;
+    BOOL gallium_log_initialized;
+    BOOL gallium_stdout;
+};
+#endif
