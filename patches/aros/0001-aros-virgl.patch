diff --git a/workbench/hidds/virgl/virgl_native.h b/workbench/hidds/virgl/virgl_native.h
new file mode 100644
index 0000000000..4645aa12c2
--- /dev/null
+++ b/workbench/hidds/virgl/virgl_native.h
@@ -0,0 +1,28 @@
+/* CRT-free native metadata and memory operations. UtilityBase is borrowed
+ * from the native module root, which is pinned through winsys destruction. */
+#ifndef AROS_VIRGL_NATIVE_H
+#define AROS_VIRGL_NATIVE_H
+#include <stddef.h>
+#include <exec/libraries.h>
+#include <exec/memory.h>
+#include <proto/exec.h>
+#include <proto/utility.h>
+static inline APTR avgl_native_alloc(size_t bytes)
+{
+    if (!bytes || bytes > (size_t)(~(ULONG)0)) return NULL;
+    return AllocVec((ULONG)bytes, MEMF_ANY | MEMF_CLEAR);
+}
+static inline void avgl_native_clear(struct Library *UtilityBase, APTR ptr, ULONG bytes)
+{
+    SetMem(ptr, 0, bytes);
+}
+static inline APTR avgl_native_grow(APTR old, size_t old_bytes, size_t new_bytes)
+{
+    if (new_bytes < old_bytes) return NULL;
+    APTR next = avgl_native_alloc(new_bytes);
+    if (!next) return NULL;
+    if (old && old_bytes) CopyMem(old, next, old_bytes);
+    FreeVec(old);
+    return next;
+}
+#endif
diff --git a/workbench/hidds/virgl/virgl_transport.c b/workbench/hidds/virgl/virgl_transport.c
new file mode 100644
index 0000000000..c0ba427a99
--- /dev/null
+++ b/workbench/hidds/virgl/virgl_transport.c
@@ -0,0 +1,567 @@
+/* Copyright (C) 2026, The AROS Development Team. All rights reserved.
+ * Experimental x86_64 synchronous PCI transport, derived from the tested
+ * manual diagnostic. No public API or default system driver is installed.
+ */
+#include <exec/memory.h>
+#include <dos/dos.h>
+#include <utility/hooks.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/oop.h>
+#include <aros/debug.h>
+
+#include <stddef.h>
+#include "virgl_transport.h"
+#include "virgl_native.h"
+struct avgl_device {
+    struct Library *utility_base;
+    OOP_Object *device, *driver;
+    unsigned matches;
+    APTR bars[6];
+    ULONG bar_sizes[6];
+    struct window windows[5];
+    ULONG notify_multiplier;
+    volatile struct virtio_pci_common_cfg *common;
+    volatile UBYTE *config;
+    volatile UBYTE *isr;
+    volatile UWORD *notify;
+    APTR dma;
+    OOP_Object *pci;
+    struct avgl_allocation *allocations;
+    UBYTE caps[8192];
+    ULONG caps_size;
+    BOOL failed, attr_owned;
+    struct SignalSemaphore queue;
+    ULONG next_context, next_resource;
+    STRPTR owner_name;
+    UQUAD fence;
+    ULONG request_dma_length, response_dma_length;
+    BOOL request_dma_active, response_dma_active;
+    volatile struct virtq_desc *desc;
+    volatile struct virtq_avail *avail;
+    volatile struct virtq_used *used;
+    UWORD last_used, command;
+    BOOL owned, changed;
+};
+OOP_AttrBase HiddPCIDeviceAttrBase;
+#define GPU_ID 0x1050
+#define PCI_COMMAND 4
+#define PCI_MEMORY 2
+#define PCI_MASTER 4
+#define PCI_INTX_DISABLE 0x400
+#define QUEUE_SIZE 8
+#define RING_BYTES 4096
+#define REQUEST_OFFSET 8192
+#define RESPONSE_OFFSET (REQUEST_OFFSET + 512 * 1024)
+#define RESPONSE_BYTES 8192
+#define DMA_BYTES (RESPONSE_OFFSET + RESPONSE_BYTES)
+#define POLL_TICKS 500
+struct avgl_allocation {
+    struct avgl_allocation *next;
+    APTR pointer;
+    ULONG bytes, context, dma_length, dma_flags;
+    BOOL dma_active;
+};
+static void finish_backing_dma(struct avgl_allocation *a)
+{
+    if(a->dma_active){
+        ULONG bytes=a->dma_length;
+        CachePostDMA(a->pointer,&bytes,a->dma_flags);
+        a->dma_active=FALSE;
+    }
+}
+static IPTR attr(OOP_Object *device, OOP_AttrID id)
+{
+    IPTR value = 0;
+    OOP_GetAttr(device, id, &value);
+    return value;
+}
+
+AROS_UFH3(void, enumerate_gpu,
+    AROS_UFHA(struct Hook *, hook, A0),
+    AROS_UFHA(OOP_Object *, device, A2),
+    AROS_UFHA(APTR, message, A1))
+{
+    AROS_USERFUNC_INIT
+    struct avgl_device *s = hook->h_Data;
+    (void)message;
+    if (attr(device, aHidd_PCIDevice_VendorID) == VIRTIO_PCI_VENDOR_ID &&
+        attr(device, aHidd_PCIDevice_ProductID) == GPU_ID &&
+        attr(device, aHidd_PCIDevice_Class) == 3 &&
+        attr(device, aHidd_PCIDevice_SubClass) == 0x80) {
+        s->device = device;
+        s->matches++;
+    }
+    AROS_USERFUNC_EXIT
+}
+
+static BOOL capabilities(struct avgl_device *s)
+{
+    UBYTE seen[256] = {0};
+    ULONG cur = HIDD_PCIDevice_ReadConfigByte(s->device, 0x34);
+    unsigned count = 0;
+    while (cur) {
+        UBYTE next, id;
+        if (cur < 0x40 || cur > 0xfc || (cur & 3) || seen[cur] || ++count > 48)
+            return FALSE;
+        seen[cur] = 1;
+        id = HIDD_PCIDevice_ReadConfigByte(s->device, cur);
+        next = HIDD_PCIDevice_ReadConfigByte(s->device, cur + 1);
+        if (id == VIRTIO_PCI_CAP_VENDOR_CFG) {
+            UBYTE type, bar;
+            UBYTE length = HIDD_PCIDevice_ReadConfigByte(s->device, cur + 2);
+            if (length < 16 || cur + length > 256) return FALSE;
+            type = HIDD_PCIDevice_ReadConfigByte(s->device, cur + 3);
+            bar = HIDD_PCIDevice_ReadConfigByte(s->device, cur + 4);
+            if (type >= 1 && type <= 4) {
+                struct window *w = &s->windows[type];
+                if (bar > 5 || w->found) return FALSE;
+                w->bar = bar;
+                w->offset = HIDD_PCIDevice_ReadConfigLong(s->device, cur + 8);
+                w->length = HIDD_PCIDevice_ReadConfigLong(s->device, cur + 12);
+                w->found = TRUE;
+                D(bug("cap type=%u bar=%u offset=%lu length=%lu\n", type, bar,
+                    (unsigned long)w->offset, (unsigned long)w->length));
+                if (type == VIRTIO_PCI_CAP_NOTIFY_CFG) {
+                    if (length < 20) return FALSE;
+                    s->notify_multiplier = HIDD_PCIDevice_ReadConfigLong(s->device, cur + 16);
+                }
+            }
+        }
+        cur = next;
+    }
+    return s->windows[1].found && s->windows[2].found &&
+           s->windows[3].found && s->windows[4].found;
+}
+
+static BOOL map_windows(struct avgl_device *s)
+{
+    static const ULONG bases[] = { aoHidd_PCIDevice_Base0, aoHidd_PCIDevice_Base1,
+        aoHidd_PCIDevice_Base2, aoHidd_PCIDevice_Base3, aoHidd_PCIDevice_Base4,
+        aoHidd_PCIDevice_Base5 };
+    static const ULONG sizes[] = { aoHidd_PCIDevice_Size0, aoHidd_PCIDevice_Size1,
+        aoHidd_PCIDevice_Size2, aoHidd_PCIDevice_Size3, aoHidd_PCIDevice_Size4,
+        aoHidd_PCIDevice_Size5 };
+    unsigned i;
+    for (i = 1; i <= 4; i++) {
+        struct window *w = &s->windows[i];
+        IPTR base = attr(s->device, HiddPCIDeviceAttrBase + bases[w->bar]);
+        IPTR size = attr(s->device, HiddPCIDeviceAttrBase + sizes[w->bar]);
+        ULONG raw = HIDD_PCIDevice_ReadConfigLong(s->device, 0x10 + 4 * w->bar);
+        if (!base || (raw & 1) || !size || size > 16 * 1024 * 1024 ||
+            w->offset > size || w->length > size - w->offset) return FALSE;
+        if (!s->bars[w->bar]) {
+            APTR mapped = HIDD_PCIDriver_MapPCI(s->driver, (APTR)(base & ~(IPTR)15), size);
+            if (!mapped || mapped == (APTR)-1) return FALSE;
+            s->bars[w->bar] = mapped;
+            s->bar_sizes[w->bar] = size;
+        }
+    }
+    if (s->windows[1].length < sizeof(*s->common) || s->windows[3].length < 1 ||
+        s->windows[4].length < 16 || (s->windows[1].offset & 3) ||
+        (s->windows[4].offset & 3)) return FALSE;
+    s->common = (APTR)((UBYTE *)s->bars[s->windows[1].bar] + s->windows[1].offset);
+    s->config = (APTR)((UBYTE *)s->bars[s->windows[4].bar] + s->windows[4].offset);
+    s->isr = (APTR)((UBYTE *)s->bars[s->windows[3].bar] + s->windows[3].offset);
+    return TRUE;
+}
+
+static BOOL reset(struct avgl_device *s)
+{
+    unsigned i;
+    s->common->device_status = 0;
+    __sync_synchronize();
+    for (i = 0; i < POLL_TICKS; i++) {
+        if (s->common->device_status == 0) return TRUE;
+        Delay(1);
+    }
+    return FALSE;
+}
+
+static UQUAD device_dma_address(struct avgl_device *s, APTR ptr)
+{
+    APTR address = HIDD_PCIDriver_CPUtoPCI(s->driver, ptr);
+    return !address || address == (APTR)-1 ? ~(UQUAD)0 : (UQUAD)(IPTR)address;
+}
+
+static BOOL setup_queue(struct avgl_device *s, UWORD id)
+{
+    UBYTE *base = (UBYTE *)s->dma + id * RING_BYTES;
+    volatile struct virtq_avail *avail = (APTR)(base + 256);
+    struct window *w = &s->windows[2];
+    UQUAD offset, desc = device_dma_address(s, base), avail_dma = device_dma_address(s, base + 256);
+    UQUAD used = device_dma_address(s, base + 512);
+    if (!desc || desc == ~(UQUAD)0 || !avail_dma || avail_dma == ~(UQUAD)0 ||
+        !used || used == ~(UQUAD)0) return FALSE;
+    s->common->queue_select = id;
+    __sync_synchronize();
+    if (s->common->queue_size < QUEUE_SIZE || s->common->queue_enable) return FALSE;
+    s->common->queue_size = QUEUE_SIZE;
+    s->common->queue_msix_vector = 0xffff;
+    s->common->queue_desc = desc;
+    s->common->queue_driver = avail_dma;
+    s->common->queue_device = used;
+    avail->flags = VIRTQ_AVAIL_F_NO_INTERRUPT;
+    offset = (UQUAD)s->common->queue_notify_off * s->notify_multiplier;
+    if (((w->offset + offset) & 1) || offset > w->length || w->length - offset < sizeof(UWORD)) return FALSE;
+    if (!id) s->notify = (APTR)((UBYTE *)s->bars[w->bar] + w->offset + offset);
+    __sync_synchronize();
+    s->common->queue_enable = 1;
+    return TRUE;
+}
+
+/* Before publication, after a valid used-ring completion, or after successful
+ * physical reset only. A lost completion keeps these registrations in root
+ * quarantine together with the DMA allocation. */
+static void finish_queue_dma(struct avgl_device *s)
+{
+    ULONG length;
+    if(s->response_dma_active){
+        length=s->response_dma_length;
+        CachePostDMA((UBYTE*)s->dma+RESPONSE_OFFSET,&length,0);
+        s->response_dma_active=FALSE;
+    }
+    if(s->request_dma_active){
+        length=s->request_dma_length;
+        CachePostDMA((UBYTE*)s->dma+REQUEST_OFFSET,&length,DMA_ReadFromRAM);
+        s->request_dma_active=FALSE;
+    }
+}
+
+static BOOL raw_command(struct avgl_device *s, const void *input, ULONG req_len,
+                    ULONG expected, ULONG minimum, ULONG *received, BOOL fenced)
+{
+    struct gpu_header *req = (APTR)((UBYTE *)s->dma + REQUEST_OFFSET);
+    struct gpu_header *resp = (APTR)((UBYTE *)s->dma + RESPONSE_OFFSET);
+    ULONG type, len, i;
+    UQUAD request_address, response_address;
+    UWORD index;
+    if(s->request_dma_active || s->response_dma_active){s->failed=TRUE;return FALSE;}
+    if (req_len < sizeof(*req) || req_len > RESPONSE_OFFSET - REQUEST_OFFSET)
+        return FALSE;
+    request_address=device_dma_address(s,req);
+    response_address=device_dma_address(s,resp);
+    if(!request_address || request_address==~(UQUAD)0 ||
+        !response_address || response_address==~(UQUAD)0)return FALSE;
+    CopyMem(input, req, req_len);
+    avgl_native_clear(s->utility_base, resp, RESPONSE_BYTES);
+    type = req->type;
+    if (fenced) {
+        if(s->fence==~(UQUAD)0)return FALSE;
+        req->flags = GPU_FLAG_FENCE; req->fence = ++s->fence;
+    }
+    len = req_len;
+    if (!CachePreDMA(req, &len, DMA_ReadFromRAM)) return FALSE;
+    s->request_dma_length=len;s->request_dma_active=TRUE;
+    if(len<req_len){finish_queue_dma(s);return FALSE;}
+    len = RESPONSE_BYTES;
+    if (!CachePreDMA(resp, &len, 0)){finish_queue_dma(s);return FALSE;}
+    s->response_dma_length=len;s->response_dma_active=TRUE;
+    if(len<RESPONSE_BYTES){finish_queue_dma(s);return FALSE;}
+    s->desc[0].addr = request_address;
+    s->desc[0].len = req_len;
+    s->desc[0].flags = VIRTQ_DESC_F_NEXT;
+    s->desc[0].next = 1;
+    s->desc[1].addr = response_address;
+    s->desc[1].len = RESPONSE_BYTES;
+    s->desc[1].flags = VIRTQ_DESC_F_WRITE;
+    s->desc[1].next = 0;
+    index = s->avail->idx;
+    s->avail->ring[index % QUEUE_SIZE] = 0;
+    __sync_synchronize();
+    s->avail->idx = index + 1;
+    __sync_synchronize();
+    *s->notify = 0;
+    for (i = 0; i < POLL_TICKS; i++) {
+        __sync_synchronize();
+        if (s->used->idx != s->last_used) break;
+        if (SetSignal(0, 0) & SIGBREAKF_CTRL_C) break;
+        Delay(1);
+    }
+    if (s->used->idx == s->last_used) {
+        bug("FAIL: command 0x%lx timed out\n", (unsigned long)type);
+        s->failed=TRUE;return FALSE;
+    }
+    __sync_synchronize();
+    *received = s->used->ring[s->last_used % QUEUE_SIZE].len;
+    if (s->used->idx != (UWORD)(s->last_used + 1) ||
+        s->used->ring[s->last_used % QUEUE_SIZE].id != 0) {s->failed=TRUE;return FALSE;}
+    s->last_used++;
+    finish_queue_dma(s);
+    (void)*s->isr;
+    if (*received < sizeof(*resp) || *received > RESPONSE_BYTES ||
+        (fenced && (!(resp->flags & GPU_FLAG_FENCE) || resp->fence != s->fence))) {
+        s->failed=TRUE;return FALSE;
+    }
+    /* A complete, fenced protocol error is scoped to the operation. A lost
+     * or malformed completion instead poisons this physical queue for all. */
+    if (resp->type >= GPU_ERR_UNSPEC && resp->type <= GPU_ERR_INVALID_PARAMETER) {
+        bug("[virgl] rejected command 0x%lx response=0x%lx\n",
+            (unsigned long)type,(unsigned long)resp->type);
+        return FALSE;
+    }
+    if (*received < minimum || resp->type != expected) {
+        s->failed=TRUE;return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL query(struct avgl_device *s, ULONG type, ULONG a, ULONG b,
+                  ULONG expected, ULONG minimum, ULONG *received)
+{
+    struct capset_request req = {0};
+    req.header.type = type; req.id = a; req.version = b;
+    return raw_command(s, &req, type == GPU_GET_DISPLAY ? sizeof(req.header) : sizeof(req),
+                   expected, minimum, received, FALSE);
+}
+
+
+/* Failure retains the entire device: BARs, PCI object/claim, attribute base,
+ * queue DMA and backing registry. Never leave dangling DMA ownership. */
+static BOOL device_close(struct avgl_device *s)
+{
+    unsigned i;
+    if (s->changed && !reset(s)) {
+        s->failed=TRUE;
+        bug("[virgl] reset failed; complete device quarantined until reboot\n");
+        return FALSE;
+    }
+    finish_queue_dma(s);
+    if (s->owned) HIDD_PCIDevice_WriteConfigWord(s->device,PCI_COMMAND,s->command);
+    while (s->allocations) {
+        struct avgl_allocation *a=s->allocations;s->allocations=a->next;
+        finish_backing_dma(a);
+        HIDD_PCIDriver_FreePCIMem(s->driver,a->pointer);FreeVec(a);
+    }
+    if (s->dma) HIDD_PCIDriver_FreePCIMem(s->driver,s->dma);
+    for (i=0;i<6;i++) if(s->bars[i])
+        HIDD_PCIDriver_UnmapPCI(s->driver,s->bars[i],s->bar_sizes[i]);
+    if(s->owned)HIDD_PCIDevice_Release(s->device);
+    FreeVec(s->owner_name);
+    if(s->pci)OOP_DisposeObject(s->pci);
+    if(s->attr_owned){OOP_ReleaseAttrBase(IID_Hidd_PCIDevice);HiddPCIDeviceAttrBase=0;}
+    return TRUE;
+}
+
+static BOOL device_open(struct avgl_device *s, struct Library *utility_base)
+{
+    struct Hook hook = { .h_Entry = (APTR)enumerate_gpu, .h_Data = s };
+    struct TagItem requirements[] = {{tHidd_PCI_VendorID, VIRTIO_PCI_VENDOR_ID},{TAG_DONE,0}};
+    UQUAD have, wanted;
+    ULONG cap_count, i, bytes;
+    avgl_native_clear(utility_base, s, sizeof(*s));
+    s->utility_base = utility_base;
+    InitSemaphore(&s->queue);
+    HiddPCIDeviceAttrBase = OOP_ObtainAttrBase(IID_Hidd_PCIDevice);
+    if (!HiddPCIDeviceAttrBase) return FALSE;
+    s->attr_owned=TRUE;
+    s->pci = OOP_NewObject(NULL, CLID_Hidd_PCI, NULL);
+    if (!s->pci) goto fail;
+    HIDD_PCI_EnumDevices(s->pci, &hook, requirements);
+    if (s->matches != 1) { bug("[virgl] need one secondary GPU, got %u\n",s->matches); goto fail; }
+    s->owner_name = AllocVec(80, MEMF_ANY);
+    if (!s->owner_name) goto fail;
+    CopyMem("virgl prototype (reset failure requires reboot)", s->owner_name,
+        sizeof("virgl prototype (reset failure requires reboot)"));
+    if (HIDD_PCIDevice_Obtain(s->device,s->owner_name)) { bug("[virgl] device busy\n"); goto fail; }
+    s->owned = TRUE;
+    s->command = HIDD_PCIDevice_ReadConfigWord(s->device,PCI_COMMAND);
+    s->driver = (APTR)attr(s->device,aHidd_PCIDevice_Driver);
+    if (!s->driver || !capabilities(s)) goto fail;
+    HIDD_PCIDevice_WriteConfigWord(s->device,PCI_COMMAND,s->command|PCI_MEMORY);
+    if (!map_windows(s) || s->common->device_status != 0) goto fail;
+    HIDD_PCIDevice_WriteConfigWord(s->device,PCI_COMMAND,s->command|PCI_MEMORY|PCI_MASTER|PCI_INTX_DISABLE);
+    s->changed = TRUE;
+    if (!reset(s)) goto fail;
+    s->common->device_status = VIRTIO_CONFIG_S_ACKNOWLEDGE|VIRTIO_CONFIG_S_DRIVER;
+    s->common->device_feature_select=0; __sync_synchronize(); have=s->common->device_feature;
+    s->common->device_feature_select=1; __sync_synchronize(); have|=(UQUAD)s->common->device_feature<<32;
+    wanted=(1ULL<<VIRTIO_F_VERSION_1)|GPU_F_VIRGL;
+    if ((have&wanted)!=wanted) goto fail;
+    s->common->guest_feature_select=0; s->common->guest_feature=(ULONG)wanted;
+    s->common->guest_feature_select=1; s->common->guest_feature=(ULONG)(wanted>>32);
+    __sync_synchronize(); s->common->device_status|=VIRTIO_CONFIG_S_FEATURES_OK;
+    __sync_synchronize(); if (!(s->common->device_status&VIRTIO_CONFIG_S_FEATURES_OK)) goto fail;
+    cap_count=*(volatile ULONG*)(s->config+12);
+    if (!cap_count || cap_count>16 || s->common->num_queues<2) goto fail;
+    s->dma=HIDD_PCIDriver_AllocPCIMem(s->driver,DMA_BYTES);
+    if (!s->dma) goto fail;
+    avgl_native_clear(s->utility_base, s->dma, DMA_BYTES); s->desc=s->dma;
+    s->avail=(APTR)((UBYTE*)s->dma+256); s->used=(APTR)((UBYTE*)s->dma+512);
+    if (!setup_queue(s,0)||!setup_queue(s,1)) goto fail;
+    s->common->device_status|=VIRTIO_CONFIG_S_DRIVER_OK;
+    /* Legacy capset1 deliberately excludes blob/fence-fd features in this prototype. */
+    for (i=0;i<cap_count;i++) {
+        struct capset_info *info; ULONG version,size;
+        if (!query(s,GPU_GET_CAPSET_INFO,i,0,GPU_OK_CAPSET_INFO,sizeof(*info),&bytes)) goto fail;
+        info=(APTR)((UBYTE*)s->dma+RESPONSE_OFFSET);
+        if (info->id!=1) continue;
+        version=info->version; size=info->size;
+        if (!size||size>sizeof(s->caps)||size>RESPONSE_BYTES-sizeof(struct gpu_header)) goto fail;
+        if (!query(s,GPU_GET_CAPSET,1,version,GPU_OK_CAPSET,size+sizeof(struct gpu_header),&bytes)) goto fail;
+        CopyMem((UBYTE*)s->dma+RESPONSE_OFFSET+sizeof(struct gpu_header),s->caps,size);
+        s->caps_size=size; break;
+    }
+    if (!s->caps_size) goto fail;
+    D(bug("[virgl] transport ready, capset1=%lu bytes\n",(unsigned long)s->caps_size));
+    return TRUE;
+ fail:
+    return FALSE;
+}
+
+void avgl_manager_init(struct avgl_manager *m, struct Library *utility_base)
+{
+    InitSemaphore(&m->mutex);m->utility_base=utility_base;m->initialized=TRUE;
+}
+BOOL avgl_manager_can_expunge(struct avgl_manager *m)
+{
+    BOOL ok;
+    if(!m->initialized)return TRUE;
+    ObtainSemaphore(&m->mutex);ok=!m->device && !m->references;ReleaseSemaphore(&m->mutex);
+    return ok;
+}
+BOOL avgl_healthy(struct avgl_transport *s)
+{
+    BOOL ok;
+    if(!s->device || s->failed)return FALSE;
+    ObtainSemaphore(&s->device->queue);ok=!s->device->failed;ReleaseSemaphore(&s->device->queue);
+    return ok;
+}
+BOOL avgl_command(struct avgl_transport *s,const void *input,ULONG bytes,
+    ULONG expected,ULONG minimum,ULONG *received,BOOL fenced)
+{
+    BOOL ok;
+    if(!s->device || s->failed)return FALSE;
+    ObtainSemaphore(&s->device->queue);
+    ok=!s->device->failed && raw_command(s->device,input,bytes,expected,minimum,received,fenced);
+    if(ok && ((const struct gpu_header *)input)->type==GPU_RESOURCE_CREATE_3D)s->resources_live++;
+    ReleaseSemaphore(&s->device->queue);return ok;
+}
+BOOL avgl_cleanup_command(struct avgl_transport *s,const void *input,ULONG bytes)
+{
+    BOOL ok;ULONG received;
+    if(!s->device)return FALSE;
+    ObtainSemaphore(&s->device->queue);
+    ok=!s->device->failed && raw_command(s->device,input,bytes,GPU_OK_NODATA,
+        sizeof(struct gpu_header),&received,TRUE);
+    if(ok && ((const struct gpu_header *)input)->type==GPU_RESOURCE_UNREF && s->resources_live)s->resources_live--;
+    ReleaseSemaphore(&s->device->queue);return ok;
+}
+ULONG avgl_resource_id(struct avgl_transport *s)
+{
+    ULONG id=0;struct avgl_device *d=s->device;
+    ObtainSemaphore(&d->queue);
+    if(!s->failed && !d->failed && d->next_resource!=~(ULONG)0)id=++d->next_resource;
+    ReleaseSemaphore(&d->queue);return id;
+}
+UQUAD avgl_dma_address(struct avgl_transport *s,APTR pointer)
+{ return device_dma_address(s->device,pointer); }
+APTR avgl_alloc(struct avgl_transport *s,ULONG bytes)
+{
+    struct avgl_device *d=s->device;struct avgl_allocation *a=NULL;APTR result=NULL;
+    if(!bytes || bytes>32*1024*1024 || s->failed)return NULL;
+    ObtainSemaphore(&d->queue);
+    if(d->failed)goto done;
+    a=avgl_native_alloc(sizeof(*a));if(!a)goto done;
+    a->bytes=bytes;a->context=s->context;
+    a->pointer=HIDD_PCIDriver_AllocPCIMem(d->driver,bytes);
+    if(!a->pointer){FreeVec(a);goto done;}
+    avgl_native_clear(d->utility_base,a->pointer,bytes);
+    a->next=d->allocations;d->allocations=a;result=a->pointer;
+done:
+    ReleaseSemaphore(&d->queue);return result;
+}
+void avgl_free(struct avgl_transport *s,APTR pointer)
+{
+    struct avgl_device *d=s->device;struct avgl_allocation **a;
+    if(!pointer)return;
+    ObtainSemaphore(&d->queue);a=&d->allocations;
+    if(!d->failed){
+        while(*a && (*a)->pointer!=pointer)a=&(*a)->next;
+        if(*a && (*a)->context==s->context && !(*a)->dma_active){struct avgl_allocation *old=*a;*a=old->next;
+            HIDD_PCIDriver_FreePCIMem(d->driver,old->pointer);FreeVec(old);}
+    }
+    ReleaseSemaphore(&d->queue);
+}
+/* Registration belongs to root backing, so a lost command cannot outlive it. */
+BOOL avgl_backing_begin(struct avgl_transport *s,APTR pointer,ULONG flags)
+{
+    struct avgl_device *d=s->device;struct avgl_allocation *a;BOOL ok=FALSE;
+    ObtainSemaphore(&d->queue);
+    if(s->failed || d->failed)goto done;
+    for(a=d->allocations;a && a->pointer!=pointer;a=a->next){}
+    if(!a || a->context!=s->context || a->dma_active)goto done;
+    a->dma_length=a->bytes;a->dma_flags=flags;
+    if(!CachePreDMA(pointer,&a->dma_length,flags))goto done;
+    a->dma_active=TRUE;
+    if(a->dma_length<a->bytes){finish_backing_dma(a);goto done;}
+    ok=TRUE;
+done:
+    ReleaseSemaphore(&d->queue);return ok;
+}
+void avgl_backing_end(struct avgl_transport *s,APTR pointer)
+{
+    struct avgl_device *d=s->device;struct avgl_allocation *a;
+    ObtainSemaphore(&d->queue);
+    /* Failure may mean a published request still accesses backing. */
+    if(!d->failed){
+        for(a=d->allocations;a && a->pointer!=pointer;a=a->next){}
+        if(a && a->context==s->context)finish_backing_dma(a);
+    }
+    ReleaseSemaphore(&d->queue);
+}
+/* Manager -> queue. Ordinary work takes winsys -> queue only. */
+BOOL avgl_close(struct avgl_transport *s)
+{
+    struct avgl_manager *m=s->manager;struct avgl_device *d=s->device;
+    BOOL safe=TRUE;
+    if(!d)return TRUE;
+    ObtainSemaphore(&m->mutex);ObtainSemaphore(&d->queue);
+    /* Evidence before final reset: reset must not mask client leakage. */
+    ULONG allocations=0,bytes=0,dma=0;
+    for(struct avgl_allocation *a=d->allocations;a;a=a->next)
+        if(a->context==s->context){allocations++;bytes+=a->bytes;if(a->dma_active)dma++;}
+    bug("[virgl] close ownership ctx=%lu resources=%lu allocations=%lu bytes=%lu dma=%lu refs=%lu device_failed=%lu\n",
+        (unsigned long)s->context,(unsigned long)s->resources_live,
+        (unsigned long)allocations,(unsigned long)bytes,(unsigned long)dma,
+        (unsigned long)m->references,(unsigned long)d->failed);
+    if(s->context_created && !d->failed){
+        ULONG received;struct gpu_header req={.type=GPU_CTX_DESTROY,.context=s->context};
+        raw_command(d,&req,sizeof(req),GPU_OK_NODATA,sizeof(req),&received,TRUE);
+    }
+    s->context_created=FALSE;
+    ReleaseSemaphore(&d->queue);
+    if(--m->references==0){
+        safe=device_close(d);
+        if(safe){m->device=NULL;FreeVec(d);}
+    }
+    s->device=NULL;ReleaseSemaphore(&m->mutex);return safe;
+}
+BOOL avgl_open(struct avgl_transport *s,struct avgl_manager *m)
+{
+    struct avgl_device *d;BOOL ok=FALSE;ULONG received;
+    struct render_context req={.header.type=GPU_CTX_CREATE,.length=20,.name="AROS VirGL prototype"};
+    avgl_native_clear(m->utility_base,s,sizeof(*s));s->manager=m;s->utility_base=m->utility_base;
+    ObtainSemaphore(&m->mutex);
+    d=m->device;
+    if(!d){
+        d=avgl_native_alloc(sizeof(*d));if(!d)goto done;
+        m->device=d;
+        if(!device_open(d,m->utility_base)){
+            if(device_close(d)){m->device=NULL;FreeVec(d);}
+            goto done;
+        }
+    }
+    ObtainSemaphore(&d->queue);
+    if(d->failed || d->next_context==~(ULONG)0 || m->references==~(ULONG)0)goto unlock;
+    req.header.context=++d->next_context;
+    if(!raw_command(d,&req,sizeof(req),GPU_OK_NODATA,sizeof(struct gpu_header),&received,TRUE))goto unlock;
+    s->device=d;s->context=req.header.context;s->context_created=TRUE;
+    CopyMem(d->caps,s->caps,d->caps_size);s->caps_size=d->caps_size;
+    m->references++;ok=TRUE;
+unlock:
+    ReleaseSemaphore(&d->queue);
+    if(!ok && !m->references && device_close(d)){m->device=NULL;FreeVec(d);}
+done:
+    ReleaseSemaphore(&m->mutex);return ok;
+}
diff --git a/workbench/hidds/virgl/virgl_transport.h b/workbench/hidds/virgl/virgl_transport.h
new file mode 100644
index 0000000000..2a3d45b173
--- /dev/null
+++ b/workbench/hidds/virgl/virgl_transport.h
@@ -0,0 +1,47 @@
+/* Copyright (C) 2026, The AROS Development Team. All rights reserved. */
+#ifndef AROS_VIRGL_TRANSPORT_H
+#define AROS_VIRGL_TRANSPORT_H
+#include <exec/types.h>
+#include <exec/libraries.h>
+#include <exec/semaphores.h>
+#include <hidd/pci.h>
+#include <hardware/virtio.h>
+#include "virgl_gpu_protocol.h"
+struct avgl_allocation;
+struct window { UBYTE bar; ULONG offset, length; BOOL found; };
+struct avgl_device;
+struct avgl_manager {
+    struct SignalSemaphore mutex;
+    struct avgl_device *device;
+    struct Library *utility_base;
+    ULONG references;
+    BOOL initialized;
+};
+/* Only this logical record belongs to a winsys. All physical ownership,
+ * including quarantined allocations, remains in the root manager. */
+struct avgl_transport {
+    struct avgl_manager *manager;
+    struct avgl_device *device;
+    struct Library *utility_base;
+    UBYTE caps[8192];
+    ULONG caps_size, context, resources_live;
+    BOOL context_created, failed;
+};
+void avgl_manager_init(struct avgl_manager *m, struct Library *utility_base);
+BOOL avgl_manager_can_expunge(struct avgl_manager *m);
+BOOL avgl_healthy(struct avgl_transport *s);
+ULONG avgl_resource_id(struct avgl_transport *s);
+BOOL avgl_cleanup_command(struct avgl_transport *s, const void *input, ULONG bytes);
+
+
+
+BOOL avgl_open(struct avgl_transport *s, struct avgl_manager *manager);
+BOOL avgl_close(struct avgl_transport *s);
+BOOL avgl_command(struct avgl_transport *s, const void *input, ULONG bytes,
+    ULONG expected, ULONG minimum, ULONG *received, BOOL fenced);
+UQUAD avgl_dma_address(struct avgl_transport *s, APTR pointer);
+APTR avgl_alloc(struct avgl_transport *s, ULONG bytes);
+BOOL avgl_backing_begin(struct avgl_transport *s, APTR pointer, ULONG flags);
+void avgl_backing_end(struct avgl_transport *s, APTR pointer);
+void avgl_free(struct avgl_transport *s, APTR pointer);
+#endif
diff --git a/workbench/hidds/virgl/virgl_winsys_aros.c b/workbench/hidds/virgl/virgl_winsys_aros.c
new file mode 100644
index 0000000000..fc343df186
--- /dev/null
+++ b/workbench/hidds/virgl/virgl_winsys_aros.c
@@ -0,0 +1,319 @@
+/* Copyright (C) 2026, The AROS Development Team. All rights reserved.
+ * Single-device synchronous proof of a Mesa VirGL winsys for AROS.
+ * No DRM descriptor, native sync-fd, blob memory or external resource import.
+ */
+#include <exec/semaphores.h>
+#include <proto/exec.h>
+#include <aros/debug.h>
+
+
+#include <stdint.h>
+#include "pipe/p_state.h"
+#include "virgl_winsys_aros.h"
+#include "virgl_transport.h"
+#include "virgl_native.h"
+
+struct avgl_ws;
+struct virgl_hw_res {
+    struct virgl_hw_res *next;
+    struct avgl_ws *ws;
+    uint32_t id, size, refs, pending;
+    void *map;
+};
+struct pipe_fence_handle { unsigned refs; };
+struct avgl_cb {
+    struct virgl_cmd_buf base;
+    struct avgl_ws *ws;
+    struct virgl_hw_res **resources;
+    unsigned capacity, count, resource_capacity;
+};
+struct avgl_ws {
+    struct virgl_winsys base;
+    struct avgl_transport transport;
+    struct GalliumScreenFactory factory;
+    struct SignalSemaphore mutex;
+    struct virgl_hw_res *resources;
+    struct virgl_winsys **owner_slot;
+};
+static struct avgl_ws *ws_cast(struct virgl_winsys *ws) { return (struct avgl_ws *)ws; }
+static int ws_fd(struct virgl_winsys *ws) { (void)ws; return -1; }
+static bool send_request(struct avgl_ws *ws, const void *req, ULONG size, bool fence)
+{
+    ULONG received;
+    return avgl_command(&ws->transport,req,size,GPU_OK_NODATA,sizeof(struct gpu_header),&received,fence);
+}
+/* Only confirmed host cleanup authorizes releasing backing. On failure
+ * the root registry retains it until the last client's safe physical reset. */
+static bool cleanup_resource(struct avgl_ws *ws,uint32_t id,bool attached,bool backed,bool created)
+{
+    struct render_resource req={.resource=id};bool ok=true;
+    if(attached){req.header.type=GPU_CTX_DETACH_RESOURCE;req.header.context=ws->transport.context;
+        ok=avgl_cleanup_command(&ws->transport,&req,sizeof(req)) && ok;}
+    req.header.context=0;
+    if(backed){req.header.type=GPU_DETACH_BACKING;
+        ok=avgl_cleanup_command(&ws->transport,&req,sizeof(req)) && ok;}
+    if(created){req.header.type=GPU_RESOURCE_UNREF;
+        ok=avgl_cleanup_command(&ws->transport,&req,sizeof(req)) && ok;}
+    if(!ok)bug("[virgl] resource %lu backing retained for safe reset\n",(unsigned long)id);
+    return ok;
+}
+static void resource_ref_raw(struct avgl_ws *ws,struct virgl_hw_res **dst,struct virgl_hw_res *src)
+{
+    struct virgl_hw_res *old=*dst;
+    if (old==src) return;
+    if (src) src->refs++;
+    *dst=src;
+    if (old && --old->refs==0) {
+        struct virgl_hw_res **link=&ws->resources;
+        if(cleanup_resource(ws,old->id,true,true,true))avgl_free(&ws->transport,old->map);
+        while (*link && *link!=old) link=&(*link)->next;
+        if (*link) *link=old->next;
+        FreeVec(old);
+    }
+}
+static void ws_resource_reference(struct virgl_winsys *vws,struct virgl_hw_res **dst,struct virgl_hw_res *src)
+{
+    struct avgl_ws *ws=ws_cast(vws);
+    ObtainSemaphore(&ws->mutex);resource_ref_raw(ws,dst,src);ReleaseSemaphore(&ws->mutex);
+}
+static struct virgl_hw_res *ws_resource_create(struct virgl_winsys *vws,
+    enum pipe_texture_target target,const void *front,uint32_t format,uint32_t bind,
+    uint32_t width,uint32_t height,uint32_t depth,uint32_t array_size,uint32_t last_level,
+    uint32_t samples,uint32_t flags,uint32_t size)
+{
+    struct avgl_ws *ws=ws_cast(vws);
+    struct virgl_hw_res *res=NULL;
+    bool created=false,attached=false,backed=false;
+    ULONG native_format = ws->factory.format(ws->factory.module, GALLIUM_SCREEN_BACKEND_VIRGL, format);
+    if (native_format == GALLIUM_SCREEN_FORMAT_INVALID) return NULL;
+    struct render_create create={.header.type=GPU_RESOURCE_CREATE_3D,
+        .target=target,.format=native_format,.bind=bind,.width=width,.height=height,
+        .depth=depth,.array_size=array_size,.last_level=last_level,.samples=samples,.flags=flags};
+    struct render_resource attach={.header.type=GPU_CTX_ATTACH_RESOURCE,.header.context=ws->transport.context};
+    struct render_backing backing={.header.type=GPU_ATTACH_BACKING,.count=1,.length=size};
+    (void)front;
+    ObtainSemaphore(&ws->mutex);
+    if (!avgl_healthy(&ws->transport) || !size) goto done;
+    res=avgl_native_alloc(sizeof(*res));
+    if (!res) goto done;
+    res->ws=ws;res->id=avgl_resource_id(&ws->transport);res->refs=1;res->size=size;
+    if(!res->id){FreeVec(res);res=NULL;goto done;}
+    res->map=avgl_alloc(&ws->transport,size);
+    if (!res->map) {FreeVec(res);res=NULL;goto done;}
+    create.resource=attach.resource=backing.resource=res->id;
+    backing.address=avgl_dma_address(&ws->transport,res->map);
+    if(!backing.address || backing.address==~(UQUAD)0)goto rollback;
+    if(!send_request(ws,&create,sizeof(create),true))goto rollback;
+    created=true;
+    if(!send_request(ws,&attach,sizeof(attach),true))goto rollback;
+    attached=true;
+    if(!send_request(ws,&backing,sizeof(backing),true))goto rollback;
+    backed=true;
+    res->next=ws->resources;ws->resources=res;
+    goto done;
+ rollback:
+    if(cleanup_resource(ws,res->id,attached,backed,created))avgl_free(&ws->transport,res->map);
+    FreeVec(res);res=NULL;
+ done:
+    ReleaseSemaphore(&ws->mutex);
+    return res;
+}
+static int ws_transfer(struct virgl_winsys *vws,struct virgl_hw_res *res,
+    const struct pipe_box *box,uint32_t stride,uint32_t layer_stride,
+    uint32_t offset,uint32_t level,bool upload)
+{
+    struct avgl_ws *ws=ws_cast(vws);
+    struct render_transfer req={.header.type=upload?GPU_TRANSFER_TO_HOST_3D:GPU_TRANSFER_FROM_HOST_3D,
+        .header.context=ws->transport.context,.resource=res->id,.x=box->x,.y=box->y,.z=box->z,
+        .width=box->width,.height=box->height,.depth=box->depth,
+        .offset=offset,.level=level,.stride=stride,.layer_stride=layer_stride};
+    ULONG flags=upload?DMA_ReadFromRAM:0;
+    bool ok=false;
+    ObtainSemaphore(&ws->mutex);
+    if (offset>=res->size || box->x<0 || box->y<0 || box->z<0 ||
+        box->width<=0 || box->height<=0 || box->depth<=0) goto done;
+    if (!avgl_backing_begin(&ws->transport,res->map,flags)) goto done;
+    ok=send_request(ws,&req,sizeof(req),true);
+    avgl_backing_end(&ws->transport,res->map);
+ done:
+    /* Mesa's transfer queue does not propagate this return value. Losing a
+     * transfer invalidates this client's stream, not the shared device. */
+    if(!ok)ws->transport.failed=TRUE;
+    ReleaseSemaphore(&ws->mutex);
+    return ok?0:-1;
+}
