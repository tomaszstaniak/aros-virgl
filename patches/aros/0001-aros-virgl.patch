diff --git a/workbench/libs/mesa/mesa_aros_log.c b/workbench/libs/mesa/mesa_aros_log.c
new file mode 100644
index 0000000000..5c86fd2d4a
--- /dev/null
+++ b/workbench/libs/mesa/mesa_aros_log.c
@@ -0,0 +1,108 @@
+#include "mesa_aros_allocator.h"
+extern void mesa_aros_allocator_report(const char *) __attribute__((weak));
+/* A FILE belongs to the duplicate whose PosixC owns it, not the shared
+ * Mesa module. CLOSELIB runs before relative dependencies are released. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <proto/posixc.h>
+#include <aros/symbolsets.h>
+#include LC_LIBDEFS_FILE
+#include "util/os_misc.h"
+#include "util/u_process.h"
+#include "mesa3dgl_private.h"
+#include "mesa_posix_compat_aros.h"
+
+FILE *mesa_aros_log_file(void)
+{
+    struct Mesa3DGLBase *base = (void *)__aros_getoffsettable();
+    if (!base || !__aros_getbase_PosixCBase()) return NULL;
+    if (!base->log_initialized) {
+        FILE *file = NULL;
+        base->log_initialized = TRUE;
+        if (os_get_option("MESA_LOG_FILE_AUTO")) {
+            char path[512];
+            snprintf(path, sizeof(path), "/tmp/mesa_%s_%ld_XXXXXX.log",
+                     util_get_process_name(), (long)getpid());
+            int fd = mkstemps(path, 4);
+            if (fd >= 0) {
+                file = fdopen(fd, "w");
+                if (!file) close(fd);
+            }
+        } else {
+            const char *path = os_get_option("MESA_LOG_FILE");
+            if (path) file = fopen(path, "w");
+        }
+        base->log_file = file;
+    }
+    return base->log_file ? (FILE *)base->log_file : stderr;
+}
+FILE *mesa_aros_gallium_log_file(void)
+{
+    struct Mesa3DGLBase *base = (void *)__aros_getoffsettable();
+    if (!base || !__aros_getbase_PosixCBase()) return NULL;
+    if (!base->gallium_log_initialized) {
+        const char *path = os_get_option("GALLIUM_LOG_FILE");
+        base->gallium_log_initialized = TRUE;
+        if (path && !strcmp(path, "stdout"))
+            base->gallium_stdout = TRUE;
+        else if (path) {
+            const char *mode = "w";
+            if (*path == '+') { mode = "a"; ++path; }
+            base->gallium_log_file = fopen(path, mode);
+        }
+    }
+    if (base->gallium_log_file) return base->gallium_log_file;
+    return base->gallium_stdout ? stdout : stderr;
+}
+static int MesaLogOpen(LIBBASETYPEPTR base)
+{
+    base->log_borrowed = FALSE;
+    base->log_file = NULL;
+    base->log_initialized = FALSE;
+    base->gallium_log_file = NULL;
+    base->gallium_log_initialized = FALSE;
+    base->gallium_stdout = FALSE;
+    return TRUE;
+}
+static void MesaLogClose(LIBBASETYPEPTR base)
+{
+    FILE *owned = base->log_borrowed ? NULL : base->log_file;
+    FILE *gallium_owned = base->log_borrowed ? NULL : base->gallium_log_file;
+    BOOL borrowed = base->log_borrowed;
+    base->log_borrowed = FALSE;
+    base->gallium_log_file = NULL;
+    base->gallium_log_initialized = FALSE;
+    base->gallium_stdout = FALSE;
+    base->log_file = NULL;
+    base->log_initialized = FALSE;
+    if (owned) fclose(owned);
+    if (gallium_owned) fclose(gallium_owned);
+    if (!borrowed && mesa_aros_allocator_report) mesa_aros_allocator_report("client-close");
+}
+ADD2OPENLIB(MesaLogOpen, 0);
+ADD2CLOSELIB(MesaLogClose, 0);
+
+/* PosixC workers share their creator's fd_owner table. Their code owner must
+ * keep the client module/CRT and these explicit FILEs alive through join.
+ * Preparing here resolves getenv in the creator, never the worker/root CRT. */
+void __aros_module_worker_prepare(void)
+{
+    mesa_aros_log_file();
+    mesa_aros_gallium_log_file();
+}
+int __aros_module_worker_inherit(void *parent_base)
+{
+    struct Mesa3DGLBase *base = (void *)__aros_getoffsettable();
+    struct Mesa3DGLBase *parent = parent_base;
+    if (!base || !parent || !parent->log_initialized ||
+        !parent->gallium_log_initialized) return -1;
+    base->log_borrowed = TRUE;
+    base->log_file = parent->log_file;
+    base->log_initialized = parent->log_initialized;
+    base->gallium_log_file = parent->gallium_log_file;
+    base->gallium_log_initialized = parent->gallium_log_initialized;
+    base->gallium_stdout = parent->gallium_stdout;
+    return 0;
+}
