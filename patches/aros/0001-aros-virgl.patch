+/* Copyright (C) 2026, The AROS Development Team. All rights reserved. */
+/* Native/count diagnostics and actual printf/fflush delivery are separate checks.
+ * Every output handle remains live until all clients and cross-file checks finish. */
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <exec/execbase.h>
+#include <string.h>
+#include <dos/var.h>
+#include <dos/dosextens.h>
+#include <proto/task.h>
+#include <pthread.h>
+#define __CRTRETAIN_NOLIBBASE__
+#include <proto/crtretain.h>
+#include "../crt/test.h"
+#define CLIENTS 10
+APTR TaskResBase;
+struct Library *CrtretainBase;
+static BPTR segment, outputs[CLIENTS], report;
+static int fail_tls, fail_open, fail_init, logging, logfile, gl_client, failed_context, expunge, worker_log, virgl_client;
+static BPTR saved_error;
+void cleanup(void)
+{
+    int i;
+    SelectOutput(report);
+    if (gl_client) ((struct Process *)FindTask(NULL))->pr_CES = saved_error;
+    if (worker_log) { DeleteVar("MESA_LOG_FILE", GVF_GLOBAL_ONLY); DeleteVar("GALLIUM_LOG_FILE", GVF_GLOBAL_ONLY); }
+    if (logfile) DeleteVar("MESA_LOG_FILE", GVF_GLOBAL_ONLY);
+    if (fail_open) DeleteVar("AROS_VIRGL_QUAL_FAIL_CRTRETAIN_OPEN", GVF_GLOBAL_ONLY);
+    /* Owned test flag: DeleteFile also works on ENV handlers whose exclusive
+     * Lock makes DeleteVar fail. Never leave fault injection enabled. */
+    if(fail_tls)DeleteFile("ENV:AROS_VIRGL_QUAL_FAIL_TLS_ALLOC");
+    if (fail_init) DeleteVar("AROS_VIRGL_QUAL_FAIL_CRTRETAIN_INIT", GVF_GLOBAL_ONLY);
+    for (i = 0; i < CLIENTS; ++i)
+        if (outputs[i]) { Close(outputs[i]); outputs[i] = 0; }
+    if (segment) { UnLoadSeg(segment); segment = 0; }
+}
+static LONG library_opens(CONST_STRPTR name)
+{
+    struct Library *base;
+    LONG count = -1;
+    Forbid();
+    base = (struct Library *)FindName(&SysBase->LibList, name);
+    if (base) count = base->lib_OpenCnt;
+    Permit();
+    return count;
+}
+/* Probe the task-resource allocator, not a copied C-runtime counter. The
+ * failure test owns these four temporary IDs and releases them in reverse. */
+static void slot_snapshot(LONG ids[4])
+{
+    int i;
+    for (i = 0; i < 4; ++i) ids[i] = AllocTaskStorageSlot();
+    for (i = 3; i >= 0; --i) if (ids[i] > 0) FreeTaskStorageSlot(ids[i]);
+    /* Free-list order is not an API contract. Cross-task reload deliberately
+     * changes it: compare the available ID set, not its allocation order. */
+    for (i = 1; i < 4; ++i) {
+        LONG value = ids[i];
+        int j = i;
+        while (j > 0 && ids[j - 1] > value) { ids[j] = ids[j - 1]; --j; }
+        ids[j] = value;
+    }
+}
+static int occurrences(const char *data, const char *needle)
+{
+    int count = 0;
+    while ((data = strstr(data, needle)) != NULL) { ++count; data += strlen(needle); }
+    return count;
+}
+struct CrossExchange {
+    struct Task *parent, *worker;
+    BYTE parent_bit, worker_bit;
+    int stage, pin_ok, reload_ok, errors;
+};
+static void cross_wait(struct CrossExchange *x, int stage, ULONG mask)
+{
+    while (__atomic_load_n(&x->stage, __ATOMIC_ACQUIRE) < stage)
+        Wait(mask);
+}
+static void cross_publish(struct CrossExchange *x, int stage, struct Task *to, ULONG mask)
+{
+    __atomic_store_n(&x->stage, stage, __ATOMIC_RELEASE);
+    Signal(to, mask);
+}
+static void *cross_worker(void *arg)
+{
+    struct CrossExchange *x = arg;
+    struct Library *owned;
+    char *(*getter)(void) = NULL;
+    x->worker = FindTask(NULL);
+    x->worker_bit = AllocSignal(-1);
+    if (x->worker_bit < 0) {
+        ++x->errors;
+        cross_publish(x, 5, x->parent, 1UL << x->parent_bit);
+        return NULL;
+    }
+    owned = OpenLibrary("crtretain.library", 0);
+    if (owned) {
+        CrtretainBase = owned;
+        getter = (char *(*)(void))ModuleTableGetter();
+    } else ++x->errors;
+    cross_publish(x, 1, x->parent, 1UL << x->parent_bit);
+    cross_wait(x, 2, 1UL << x->worker_bit);
+    if (owned) CloseLibrary(owned);
+    CrtretainBase = NULL;
+    /* Parent's independently opened base pins callback code, while this
+     * worker has closed its own base. Do not call CRT through this getter. */
+    if (getter && x->pin_ok) {
+        if (getter() != NULL) { FPrintf(report, "cross worker: selected table remains stage=%ld\n", (LONG)x->stage); ++x->errors; }
+        struct Library *root = (struct Library *)FindName(&SysBase->LibList, "crtretain.library");
+        if (root) RemLibrary(root); /* Must reject: parent's code pin is live. */
+        else ++x->errors;
+        if (getter() != NULL) { FPrintf(report, "cross worker: selected table remains stage=%ld\n", (LONG)x->stage); ++x->errors; }
+    }
+    cross_publish(x, 3, x->parent, 1UL << x->parent_bit);
+    cross_wait(x, 4, 1UL << x->worker_bit);
+    if (x->reload_ok) {
+        owned = OpenLibrary("crtretain.library", 0);
+        if (owned) {
+            CrtretainBase = owned;
+            getter = (char *(*)(void))ModuleTableGetter();
+            CloseLibrary(owned);
+            CrtretainBase = NULL;
+            if (getter() != NULL) { FPrintf(report, "cross worker: selected table remains stage=%ld\n", (LONG)x->stage); ++x->errors; }
+        } else ++x->errors;
+    }
+    cross_publish(x, 5, x->parent, 1UL << x->parent_bit);
+    FreeSignal(x->worker_bit);
+    return NULL;
+}
+static int cross_expunge(void)
+{
+    struct CrossExchange x = {0};
+    struct Library *pin = NULL, *root;
+    pthread_t worker;
+    int error;
+    LONG temporary[2];
+    x.parent = FindTask(NULL);
+    x.parent_bit = AllocSignal(-1);
+    if (x.parent_bit < 0) return 1;
+    error = pthread_create(&worker, NULL, cross_worker, &x);
+    if (error) { FreeSignal(x.parent_bit); return 1; }
+    cross_wait(&x, 1, 1UL << x.parent_bit);
+    if (x.worker_bit < 0) {
+        pthread_join(worker, NULL); FreeSignal(x.parent_bit); return 1;
+    }
+    pin = OpenLibrary("crtretain.library", 0);
+    x.pin_ok = pin != NULL;
+    if (!pin) ++x.errors;
+    cross_publish(&x, 2, x.worker, 1UL << x.worker_bit);
+    cross_wait(&x, 3, 1UL << x.parent_bit);
+    if (pin) CloseLibrary(pin);
+    root = (struct Library *)FindName(&SysBase->LibList, "crtretain.library");
+    if (root) {
+        if (root->lib_OpenCnt == 0) RemLibrary(root);
+        else ++x.errors;
+    }
+    if (FindName(&SysBase->LibList, "crtretain.library")) ++x.errors;
+    /* Deliberately change allocation order: reused IDs must not carry a
+     * closed module's selected table into another live task. */
+    temporary[0] = AllocTaskStorageSlot(); temporary[1] = AllocTaskStorageSlot();
+    if (temporary[0] > 0) FreeTaskStorageSlot(temporary[0]);
+    if (temporary[1] > 0) FreeTaskStorageSlot(temporary[1]);
+    pin = OpenLibrary("crtretain.library", 0);
+    x.reload_ok = pin != NULL;
+    if (!pin) ++x.errors;
+    cross_publish(&x, 4, x.worker, 1UL << x.worker_bit);
+    cross_wait(&x, 5, 1UL << x.parent_bit);
+    if (pthread_join(worker, NULL)) ++x.errors;
+    if (pin) CloseLibrary(pin);
+    root = (struct Library *)FindName(&SysBase->LibList, "crtretain.library");
+    if (root) {
+        if (root->lib_OpenCnt == 0) RemLibrary(root);
+        else ++x.errors;
+    }
+    if (FindName(&SysBase->LibList, "crtretain.library")) ++x.errors;
+    FreeSignal(x.parent_bit);
+    return x.errors;
+}
+/* A veto keeps the native getter's code resident after the client closes.
+ * Never invoke it after lifting the veto and releasing the final opening. */
+static int veto_expunge(void)
+{
+    struct Library *owned, *root, *pin;
+    char *(*getter)(void);
+    int errors = 0;
+    owned = OpenLibrary("crtretain.library", 0);
+    if (!owned) return 1;
+    CrtretainBase = owned;
+    getter = (char *(*)(void))ModuleTableGetter();
+    if (!SetVar("AROS_VIRGL_QUAL_FAIL_CRTRETAIN_EXPUNGE", "1", 1, GVF_GLOBAL_ONLY)) {
+        CloseLibrary(owned); CrtretainBase = NULL; return 1;
+    }
+    CloseLibrary(owned);
+    CrtretainBase = NULL;
+    root = (struct Library *)FindName(&SysBase->LibList, "crtretain.library");
+    if (!root) ++errors;
+    else {
+        if (getter() != NULL) ++errors;
+        RemLibrary(root);
+        root = (struct Library *)FindName(&SysBase->LibList, "crtretain.library");
+        if (!root) ++errors;
+        else if (getter() != NULL) ++errors;
+    }
+    pin = OpenLibrary("crtretain.library", 0);
+    if (!pin) ++errors;
+    DeleteVar("AROS_VIRGL_QUAL_FAIL_CRTRETAIN_EXPUNGE", GVF_GLOBAL_ONLY);
+    if (pin) CloseLibrary(pin);
+    root = (struct Library *)FindName(&SysBase->LibList, "crtretain.library");
+    if (root) {
+        if (root->lib_OpenCnt == 0) RemLibrary(root);
+        else ++errors;
+    }
+    if (FindName(&SysBase->LibList, "crtretain.library")) ++errors;
+    return errors;
+}
+int main(int argc, char **argv)
+{
+    const char *mode = argc > 1 ? argv[1] : "fixture";
+    const char *prefix = argc > 2 ? argv[2] : "RAM:crtretaincheck";
+    LONG baseline, stdc_baseline, rc, length, after;
+    LONG slots_before[4], slots_after[4];
+    int i, j, errors = 0;
+    expunge = !strcmp(mode, "expunge");
+    worker_log = !strcmp(mode, "worker-log") || !strcmp(mode, "worker-log-parallel") || !strcmp(mode, "worker-log-nested");
+    failed_context = !strcmp(mode, "failed-context");
+    logfile = !strcmp(mode, "logfile");
+    virgl_client = !strcmp(mode, "virgl-logging");
+    logging = logfile || !strcmp(mode, "logging") || virgl_client;
+    gl_client = logging || failed_context;
+    saved_error = ((struct Process *)FindTask(NULL))->pr_CES;
+    fail_tls = !strcmp(mode,"fail-tls-root") || !strcmp(mode,"fail-tls-open");
+    fail_open = !strcmp(mode, "fail-open");
+    fail_init = !strcmp(mode, "fail-init");
+    TaskResBase = OpenResource("task.resource");
+    report = Output();
+    if (!strcmp(mode, "cross-expunge") || !strcmp(mode, "veto-expunge")) {
+        int round;
+        baseline = library_opens("posixc.library");
+        for (round = 0; round < 10; ++round) {
+            slot_snapshot(slots_before);
+            int found = !strcmp(mode, "cross-expunge") ? cross_expunge() : veto_expunge();
+            slot_snapshot(slots_after);
+            int k;
+            for (k = 0; k < 4; ++k) if (slots_before[k] != slots_after[k]) {
+                printf("%s slot[%d] before=%ld after=%ld\n", mode, k, slots_before[k], slots_after[k]); ++found;
+            }
+            if (library_opens("posixc.library") != baseline) ++found;
+            printf("%s: round=%d errors=%d\n", mode, round, found);
+            errors += found;
+        }
+        printf("%s: errors=%d %s\n", mode, errors, errors ? "FAIL" : "PASS");
+        return errors ? 10 : 0;
+    }
+    if(!strcmp(mode,"fail-tls-open")){
+        struct Library *warm=OpenLibrary("crtretain.library",0);
+        if(!warm)return 10;CloseLibrary(warm);
+        if(!FindName(&SysBase->LibList,"crtretain.library"))return 10;
+    }
+    segment = LoadSeg(gl_client ? "PROGDIR:virglglprobe" : "PROGDIR:crtretainprobe");
+    TEST(segment != 0);
+    baseline = library_opens("posixc.library");
+    stdc_baseline = library_opens("stdc.library");
+    TEST(baseline >= 0);
+    if (logging) TEST(SetVar("MESA_DEBUG", "1", 1, GVF_GLOBAL_ONLY));
+    if(fail_tls)TEST(SetVar("AROS_VIRGL_QUAL_FAIL_TLS_ALLOC","1",1,GVF_GLOBAL_ONLY));
+    if (fail_open) TEST(SetVar("AROS_VIRGL_QUAL_FAIL_CRTRETAIN_OPEN", "1", 1, GVF_GLOBAL_ONLY));
+    if (fail_init || expunge || fail_tls) { TEST(TaskResBase != NULL); slot_snapshot(slots_before); }
+    if (fail_init) TEST(SetVar("AROS_VIRGL_QUAL_FAIL_CRTRETAIN_INIT", "1", 1, GVF_GLOBAL_ONLY));
+    for (i = 0; i < CLIENTS; ++i)
+    {
+        char path[512], args[128];
+        TEST(snprintf(path, sizeof(path), "%s-%d.log", prefix, i) < (int)sizeof(path));
+        TEST(snprintf(args, sizeof(args), "%s %s-client-%02d\n", (fail_open || fail_init || expunge || fail_tls) ? "fixture" : mode, mode, i) < (int)sizeof(args));
+        if (logging) snprintf(args, sizeof(args), "%s single empty logerror=%d\n", virgl_client ? "virgl" : "softpipe", i);
+        if (failed_context) snprintf(args, sizeof(args), "softpipe single empty failcontext=%d\n", i);
+        if (worker_log) {
+            char destination[512];
+            snprintf(destination, sizeof(destination), "%s-mesa-%d.log", prefix, i);
+            TEST(SetVar("MESA_LOG_FILE", destination, strlen(destination), GVF_GLOBAL_ONLY));
+            snprintf(destination, sizeof(destination), "%s-gallium-%d.log", prefix, i);
+            TEST(SetVar("GALLIUM_LOG_FILE", destination, strlen(destination), GVF_GLOBAL_ONLY));
+        }
+        if (logfile) {
+            char destination[512];
+            snprintf(destination, sizeof(destination), "%s-destination-%d.log", prefix, i);
+            BPTR initial = Open(destination, MODE_NEWFILE);
+            TEST(initial != 0);
+            Close(initial);
+            TEST(SetVar("MESA_LOG_FILE", destination, strlen(destination), GVF_GLOBAL_ONLY));
+        }
+        outputs[i] = Open(path, MODE_NEWFILE);
+        TEST(outputs[i] != 0);
+        SelectOutput(outputs[i]);
+        if (gl_client) ((struct Process *)FindTask(NULL))->pr_CES = outputs[i];
+        rc = RunCommand(segment, gl_client ? (i % 2 ? 4000000 : 2000000) : (i % 2 ? 524288 : 262144), args, strlen(args));
+        SelectOutput(report);
+        if (gl_client) ((struct Process *)FindTask(NULL))->pr_CES = saved_error;
+        Flush(outputs[i]);
+        if (expunge) {
+            struct Library *root = (struct Library *)FindName(&SysBase->LibList, "crtretain.library");
+            TEST(root != NULL && root->lib_OpenCnt == 0);
+            RemLibrary(root);
+            if (FindName(&SysBase->LibList, "crtretain.library")) ++errors;
+        }
+        after = library_opens("posixc.library");
+        printf("client %d rc=%ld posixc_before=%ld after=%ld\n", i, (long)rc, (long)baseline, (long)after);
+        if (rc != ((fail_open || fail_init || fail_tls) ? 20 : 0) || after != baseline) ++errors;
+        if (fail_init || expunge || fail_tls) {
+            if (library_opens("stdc.library") != stdc_baseline) ++errors;
+            slot_snapshot(slots_after);
+            int k;
+            for (k = 0; k < 4; ++k)
+                if (slots_after[k] != slots_before[k]) {
+                    printf("SLOT FAIL client=%d index=%d before=%ld after=%ld\n",
+                        i, k, (long)slots_before[k], (long)slots_after[k]);
+                    ++errors;
+                }
+        }
+    }
+    for (i = 0; !fail_open && !fail_init && !fail_tls && i < CLIENTS; ++i)
+    {
+        char data[8192];
+        Seek(outputs[i], 0, OFFSET_BEGINNING);
+        length = Read(outputs[i], data, sizeof(data) - 1);
+        TEST(length > 0);
+        data[length] = 0;
+        if ((!logging && !strstr(data, "result=PASS")) ||
+            (!strcmp(mode, "closed") ? !strstr(data, "closed: result=PASS") : !strstr(data, "flush=0"))) ++errors;
+        if(!strcmp(mode,"client-tls")){
+            char expected[160];
+            for(int k=0;k<CLIENTS;k++){
+                snprintf(expected,sizeof(expected),"STDIO_CLIENT_TLS[client-tls-client-%02d]",k);
+                if(occurrences(data,expected)!=(i==k))++errors;
+            }
+        }
+        for (j = 0; j < CLIENTS; ++j)
+        {
+            char marker[128];
+            int found, wanted = !strcmp(mode, "closed") ? 0 : (i == j ? 1 : 0);
+            snprintf(marker, sizeof(marker), "STDIO_CLIENT[%s-client-%02d]", logging ? "logging" : mode, j);
+            if (logging && !logfile) {
+                char error_marker[128];
+                snprintf(error_marker, sizeof(error_marker), "glEnable(0x%x)", 0x71000000U + j);
+                int actual = occurrences(data, error_marker);
+                if (actual != wanted) {
+                    printf("LOGGER DELIVERY FAIL file=%d client=%d wanted=%d found=%d\n", i, j, wanted, actual);
+                    ++errors;
+                }
+            }
+            if (!strcmp(mode, "worker") || !strcmp(mode, "worker-exit") || worker_log) {
+                char tlsmarker[128];
+                snprintf(tlsmarker, sizeof(tlsmarker), "STDIO_TLS[%s-client-%02d]", mode, j);
+                if (occurrences(data, tlsmarker) != wanted * (!strcmp(mode, "worker-log-nested") ? 2 : 1)) ++errors;
+                if (!strcmp(mode, "worker-log-nested")) {
+                    snprintf(tlsmarker, sizeof(tlsmarker), "STDIO_NESTED[%s-client-%02d]", mode, j);
+                    if (occurrences(data, tlsmarker) != wanted) ++errors;
+                }
+            }
+            found = occurrences(data, marker);
+            if (found != wanted)
+            {
+                printf("DELIVERY FAIL file=%d client=%d wanted=%d found=%d\n", i, j, wanted, found);
+                ++errors;
+            }
+        }
+    }
+    if (worker_log) {
+        const char *channels[] = {"mesa", "gallium"};
+        const char *phases[] = {"before", "worker", "after", "nested"};
+        int phases_count = !strcmp(mode, "worker-log-nested") ? 4 : 3;
+        int c, phase;
+        for (c = 0; c < 2; ++c) for (i = 0; i < CLIENTS; ++i) {
+            char path[512], data[131072];
+            snprintf(path, sizeof(path), "%s-%s-%d.log", prefix, channels[c], i);
+            BPTR destination = Open(path, MODE_OLDFILE);
+            LONG got = destination ? Read(destination, data, sizeof(data) - 1) : -1;
+            if (destination) Close(destination);
+            if (got < 0) { ++errors; got = 0; }
+            data[got] = 0;
+            if (!strcmp(mode, "worker-log-parallel")) {
+                int id, seq;
+                for (id = 0; id < 2; ++id) for (seq = 0; seq < 64; ++seq) {
+                    char payload[257], expected[512];
+                    memset(payload, 'A' + id, 256); payload[256] = 0;
+                    snprintf(expected, sizeof(expected), "WORKER_PAR[%s-client-%02d:%d:%02d:%s]", mode, i, id, seq, payload);
+                    if (occurrences(data, expected) != 1) {
+                        printf("PARALLEL LOG FAIL channel=%s file=%d worker=%d seq=%d\n", channels[c], i, id, seq);
+                        ++errors;
+                    }
+                }
+            }
+            for (j = 0; j < CLIENTS; ++j) for (phase = 0; phase < phases_count; ++phase) {
+                char marker[128];
+                snprintf(marker, sizeof(marker), "WORKER_LOG[%s-client-%02d:%s]", mode, j, phases[phase]);
+                if (occurrences(data, marker) != (i == j)) {
+                    printf("WORKER LOG FAIL channel=%s file=%d client=%d phase=%s\n", channels[c], i, j, phases[phase]);
+                    ++errors;
+                }
+            }
+        }
+    }
+    if (logfile) {
+        for (i = 0; i < CLIENTS; ++i) {
+            char path[512], data[8192];
+            snprintf(path, sizeof(path), "%s-destination-%d.log", prefix, i);
+            BPTR destination = Open(path, MODE_OLDFILE);
+            LONG got = destination ? Read(destination, data, sizeof(data) - 1) : -1;
+            if (destination) Close(destination);
+            if (got < 0) { ++errors; got = 0; }
+            data[got] = 0;
+            for (j = 0; j < CLIENTS; ++j) {
+                char marker[128];
+                snprintf(marker, sizeof(marker), "glEnable(0x%x)", 0x71000000U + j);
+                int actual = occurrences(data, marker), wanted = i == j;
+                if (actual != wanted) {
+                    printf("LOGFILE DELIVERY FAIL file=%d client=%d wanted=%d found=%d\n", i, j, wanted, actual);
+                    ++errors;
+                }
+            }
+        }
+    }
+    printf("ownership+stdio: clients=%d errors=%d\n", CLIENTS, errors);
+    TEST(errors == 0);
+    cleanup();
+    return OK;
+}
diff --git a/developer/debug/test/library/crtretainprobe.c b/developer/debug/test/library/crtretainprobe.c
new file mode 100644
index 0000000000..0ccb31e0ac
