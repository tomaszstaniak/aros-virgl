@@ -0,0 +1,49 @@
+# Copyright (C) 2026, The AROS Development Team. All rights reserved.
+include $(SRCDIR)/config/aros.cfg
+include $(SRCDIR)/workbench/libs/mesa/mesa.cfg
+
+ifeq ($(AROS_TARGET_CPU),x86_64)
+SAFETY_CFLAGS += -Werror=implicit-function-declaration
+USER_CFLAGS += -Wall -Wextra
+USER_INCLUDES += -iquote $(top_srcdir)/src/gallium/drivers \
+    -iquote $(top_srcdir)/src/gallium/include \
+    -iquote $(top_srcdir)/src/gallium/auxiliary \
+    -iquote $(top_srcdir)/src/virtio \
+    -iquote $(top_builddir)/src
+
+# Pure fault fixture, no hardware access; not an automatic graphics run.
+#MM test-virgl-winsys : includes linklibs mesa3d-fetch
+%build_progs mmake=test-virgl-winsys \
+    files=virglwinsystest targetdir=$(AROS_TESTS)/hidds/gfx
+# Execute the real pinned core caller; keep unrelated entry points out of the finite fixture.
+USER_CFLAGS += -ffunction-sections -fdata-sections
+USER_INCLUDES += -iquote $(SRCDIR)/workbench/libs/mesa \
+    -iquote $(top_srcdir)/src -iquote $(top_srcdir)/include \
+    -iquote $(top_builddir)/src/compiler -iquote $(top_builddir)/src/compiler/nir \
+    -iquote $(GENDIR)/workbench/libs/mesa/src/compiler/nir \
+    -iquote $(SRCDIR)/workbench/hidds/virgl \
+    -iquote $(GENDIR)/workbench/hidds/virgl/$(MESAGLVERSION)/include
+
+#MM test-virgl-core-failure : includes linklibs mesa3d-fetch
+# Trim only the vendor object. Garbage collection on an AROS executable's
+# initial partial link can discard its startup and library initialization sets.
+CORE_FIXTURE_DIR := $(GENDIR)/$(CURDIR)/core
+CORE_FIXTURE_SOURCES := $(addprefix $(top_srcdir)/src/gallium/drivers/virgl/,virgl_context virgl_transfer_queue virgl_encode)
+CORE_FIXTURE_OBJECTS := $(addprefix $(CORE_FIXTURE_DIR)/,virgl_context.o virgl_transfer_queue.o virgl_encode.o)
+$(CORE_FIXTURE_DIR):
+	$(MKDIR) -p $@
+$(CORE_FIXTURE_OBJECTS): | $(CORE_FIXTURE_DIR)
+%rule_compile_multi mmake=virgl-core-fixture basenames="$(CORE_FIXTURE_SOURCES)" targetdir=$(CORE_FIXTURE_DIR)
+
+$(CORE_FIXTURE_DIR)/callers.o: $(CORE_FIXTURE_OBJECTS)
+	$(AROS_LD) -r --gc-sections -u virgl_flush_eq -u virgl_transfer_queue_init -u virgl_transfer_queue_unmap -u virgl_transfer_queue_fini -u virgl_encoder_create_sub_ctx -o $@ $^
+
+%build_prog mmake=test-virgl-core-failure progname=virglcorefailuretest \
+    objs=$(CORE_FIXTURE_DIR)/callers.o targetdir=$(AROS_TESTS)/hidds/gfx
+
+#MM test-virgl-presentation : includes linklibs hidd-virgl-prototype
+%build_prog mmake=test-virgl-presentation progname=virglpresentationtest \
+    targetdir=$(AROS_TESTS)/hidds/gfx
+
+%common
+endif
diff --git a/developer/debug/test/hidds/virtio-gpu/winsys/virglcorefailuretest.c b/developer/debug/test/hidds/virtio-gpu/winsys/virglcorefailuretest.c
new file mode 100644
index 0000000000..09a40a6a1f
--- /dev/null
+++ b/developer/debug/test/hidds/virtio-gpu/winsys/virglcorefailuretest.c
@@ -0,0 +1,82 @@
+/* Actual pinned VirGL flush and transfer queue callers over the native winsys.
+ * The hardware is the existing deterministic transport fixture. Unused draw
+ * upload and stack-owned transfer destruction are boundary substitutes. */
+#define VIRGL_WINSYS_FIXTURE 1
+#include "../virgltransport_fixture.h"
+#include "../../../../../../workbench/hidds/virgl/virgl_winsys_aros.c"
+#include "virgl/virgl_context.h"
+#include "virgl/virgl_screen.h"
+#include "virgl/virgl_resource.h"
+#include "virgl/virgl_encode.h"
+#include "util/u_upload_mgr.h"
+int virgl_debug;
+static unsigned unexpected_upload,transfers_destroyed;
+void u_upload_unmap(struct u_upload_mgr *u){(void)u;unexpected_upload++;}
+void virgl_resource_destroy_transfer(struct virgl_context *ctx,struct virgl_transfer *xfer)
+{
+    struct virgl_winsys *ws=virgl_screen(ctx->base.screen)->vws;
+    ws->resource_reference(ws,&xfer->hw_res,NULL);transfers_destroyed++;
+}
+static struct Library factory_module;
+static ULONG fixture_format(struct Library *m,ULONG backend,ULONG format)
+{(void)m;return backend==GALLIUM_SCREEN_BACKEND_VIRGL && format==PIPE_FORMAT_B8G8R8A8_UNORM?VIRGL_FORMAT_B8G8R8A8_UNORM:GALLIUM_SCREEN_FORMAT_INVALID;}
+static const struct GalliumScreenFactory factory={.version=GALLIUM_SCREEN_FACTORY_VERSION,.size=sizeof(factory),.module=&factory_module,.backends=GALLIUM_SCREEN_BACKEND_VIRGL,.format=fixture_format};
+static struct virgl_hw_res *resource(struct virgl_winsys *ws)
+{return ws->resource_create(ws,PIPE_TEXTURE_2D,NULL,PIPE_FORMAT_B8G8R8A8_UNORM,PIPE_BIND_RENDER_TARGET,4,4,1,1,0,1,0,64);}
+static int run_case(unsigned mode)
+{
+    struct virgl_winsys *a=NULL,*b=NULL;struct virgl_screen screen={0},peer_screen={0};
+    struct virgl_context ctx={0},peer={0};struct pipe_fence_handle *f=NULL,*pf=NULL;
+    struct virgl_resource pres={0};struct virgl_transfer xfer={0};
+    fixture_init();unexpected_upload=transfers_destroyed=0;
+    a=avgl_winsys_create(&a,&factory,&manager);b=avgl_winsys_create(&b,&factory,&manager);TEST(a && b);
+    struct virgl_hw_res *ra=resource(a);ULONG own_generation=last_pci_generation;
+    struct virgl_hw_res *rb=resource(b);TEST(ra && rb);
+    memset(b->resource_map(b,rb),0x22,64);
+    screen.vws=a;peer_screen.vws=b;ctx.base.screen=&screen.base;peer.base.screen=&peer_screen.base;
+    ctx.cbuf=a->cmd_buf_create(a,64);peer.cbuf=b->cmd_buf_create(b,64);TEST(ctx.cbuf && peer.cbuf);
+    ctx.hw_sub_ctx_id=7;peer.hw_sub_ctx_id=9;
+    virgl_transfer_queue_init(&ctx.queue,&ctx);virgl_transfer_queue_init(&peer.queue,&peer);
+    virgl_encoder_create_sub_ctx(&ctx,7);virgl_encoder_create_sub_ctx(&peer,9);
+    if(mode>=4 && mode<=6){
+        pres.b.target=PIPE_TEXTURE_2D;pres.b.width0=pres.b.height0=4;
+        xfer.base.resource=&pres.b;xfer.base.box.width=xfer.base.box.height=4;xfer.base.box.depth=1;
+        xfer.base.stride=16;xfer.l_stride=64;
+        a->resource_reference(a,&xfer.hw_res,ra);
+        TEST(virgl_transfer_queue_unmap(&ctx.queue,&xfer)==0);
+    }
+    ULONG before=resets;
+    if(mode==0)fail_allocation=attempts+1;
+    if(mode==1)fail_allocation=attempts+2;
+    if(mode==2){reject_next=TRUE;reject_type=GPU_SUBMIT_3D;}
+    if(mode==3)fail_pre=pre_attempts+1;
+    if(mode==4){reject_next=TRUE;reject_type=GPU_TRANSFER_TO_HOST_3D;}
+    if(mode==5)fail_pre=pre_attempts+1;
+    if(mode==6)short_pre=pre_attempts+1;
+    if(mode==7){reject_next=TRUE;reject_type=GPU_TRANSFER_FROM_HOST_3D;
+        struct pipe_box box={.width=4,.height=4,.depth=1};TEST(a->transfer_get(a,ra,&box,16,64,0,0)==-1);}
+    virgl_flush_eq(&ctx,NULL,&f);
+    fail_allocation=fail_pre=short_pre=0;reject_next=FALSE;
+    if(f)a->fence_reference(a,&f,NULL);
+    virgl_flush_eq(&ctx,NULL,&f);
+    BOOL false_success=f && a->fence_wait(a,f,0);
+    BOOL stale_map=a->resource_map(a,ra)!=NULL;
+    printf("actual core mode=%u later_fence_success=%d stale_map=%d peer_healthy=%d\n",mode,false_success,stale_map,avgl_healthy(&ws_cast(b)->transport));
+    TEST(!false_success && !stale_map && avgl_healthy(&ws_cast(b)->transport));
+    TEST(!unexpected_upload);if(mode>=4 && mode<=6){TEST(transfers_destroyed==1);}
+    virgl_flush_eq(&peer,NULL,&pf);TEST(pf && b->fence_wait(b,pf,0));
+    TEST(((UBYTE*)b->resource_map(b,rb))[0]==0x22 && resets==before);
+    a->fence_reference(a,&f,NULL);b->fence_reference(b,&pf,NULL);
+    virgl_transfer_queue_fini(&ctx.queue);virgl_transfer_queue_fini(&peer.queue);
+    a->cmd_buf_destroy(ctx.cbuf);b->cmd_buf_destroy(peer.cbuf);
+    a->resource_reference(a,&ra,NULL);TEST(!fixture_generation_live(own_generation));
+    a->destroy(a);TEST(!a && manager.references==1 && resets==before);
+    b->resource_reference(b,&rb,NULL);b->destroy(b);
+    TEST(!live && !active_pre && !wrong_free && !bad_post);return OK;
+}
+int main(void)
+{
+    unsigned failures=0;
+    for(unsigned mode=0;mode<8;mode++){if(run_case(mode)!=OK)failures++;cleanup();}
+    printf("actual core failure cases: failures=%u\n",failures);return failures?FAIL:OK;
+}
diff --git a/developer/debug/test/hidds/virtio-gpu/winsys/virglpresentationtest.c b/developer/debug/test/hidds/virtio-gpu/winsys/virglpresentationtest.c
