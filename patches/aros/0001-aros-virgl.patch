--- /dev/null
+++ b/developer/debug/test/hidds/virtio-gpu/winsys/virglpresentationtest.c
@@ -0,0 +1,66 @@
+/* Execute the actual HIDD presentation method with boundary-only substitutes. */
+#include <stdio.h>
+#include <string.h>
+#include <proto/graphics.h>
+#include <proto/arossupport.h>
+#include <proto/cybergraphics.h>
+#include <oop/oop.h>
+#define LC_LIBDEFS_FILE "virgl_libdefs.h"
+#include "../../../../../../workbench/hidds/virgl/virgl_intern.h"
+#include "../../../../../../workbench/hidds/virgl/virgl_winsys_aros.h"
+#include "virgl/virgl_resource.h"
+#include "../../../crt/test.h"
+/* The other class methods are linked but never invoked by this fixture. */
+struct virgl_winsys *avgl_winsys_create(struct virgl_winsys **owner,
+    const struct GalliumScreenFactory *factory, struct avgl_manager *manager)
+{ (void)owner; (void)factory; (void)manager; return NULL; }
+void avgl_winsys_dispose(struct virgl_winsys *ws) { (void)ws; }
+static struct RastPort test_rp;
+static UBYTE pixels[64];
+static unsigned reads,maps,allocs,frees,writes,null_writes;
+static BOOL read_ok,map_ok,alloc_ok,peer_loss;
+static struct RastPort *present_alloc(void){allocs++;return alloc_ok?&test_rp:NULL;}
+static void present_free(struct RastPort *rp){if(rp==&test_rp)frees++;}
+static ULONG present_write(APTR src,ULONG sx,ULONG sy,ULONG stride,struct RastPort *rp,
+    ULONG dx,ULONG dy,ULONG width,ULONG height,ULONG format)
+{
+    (void)sx;(void)sy;(void)stride;(void)rp;(void)dx;(void)dy;(void)width;(void)height;(void)format;
+    writes++;if(!src)null_writes++;return 0;
+}
+static bool present_read(struct virgl_winsys *ws,struct virgl_hw_res *res,unsigned w,unsigned h,unsigned stride)
+{(void)ws;(void)res;(void)w;(void)h;(void)stride;reads++;if(peer_loss)map_ok=FALSE;return read_ok;}
+static void *present_map(struct virgl_winsys *ws,struct virgl_hw_res *res)
+{(void)ws;(void)res;maps++;return map_ok?pixels:NULL;}
+#undef CreateRastPort
+#undef FreeRastPort
+#undef WritePixelArray
+#define CreateRastPort() present_alloc()
+#define FreeRastPort(rp) present_free(rp)
+#define WritePixelArray(s,sx,sy,st,r,dx,dy,w,h,f) present_write(s,sx,sy,st,r,dx,dy,w,h,f)
+#define avgl_read_resource present_read
+#include "../../../../../../workbench/hidds/virgl/virgl_galliumclass.c"
+int main(void)
+{
+    unsigned failures=0;
+    for(unsigned mode=0;mode<4;mode++){
+        struct IntHiddVirglBase base={0};OOP_Class cl={0};struct BitMap bitmap={0};
+        struct virgl_winsys ws={0};struct virgl_resource res={0};
+        struct HiddGalliumVirglData data={0};
+        struct pHidd_Gallium_DisplayResource msg={0};
+        reads=maps=allocs=frees=writes=null_writes=0;read_ok=map_ok=alloc_ok=TRUE;peer_loss=FALSE;
+        if(mode==1)peer_loss=TRUE;if(mode==2)read_ok=FALSE;if(mode==3)alloc_ok=FALSE;
+        cl.UserData=&base;cl.InstOffset=0;data.winsys=&ws;ws.resource_map=present_map;
+        res.b.format=PIPE_FORMAT_B8G8R8A8_UNORM;res.b.width0=res.b.height0=4;
+        res.metadata.stride[0]=16;res.hw_res=(void*)1;
+        msg.resource=&res;msg.bitmap=&bitmap;msg.width=msg.height=4;
+        HiddVirgl__Hidd_Gallium__DisplayResource(&cl,(OOP_Object*)&data,&msg);
+        BOOL okay=!null_writes && frees==(alloc_ok?allocs:0) &&
+            (mode==0?(writes==1 && maps==1 && allocs==1):writes==0);
+        if(mode==1)okay=okay && reads==1 && maps==1 && allocs==0;
+        if(mode==2)okay=okay && reads==1 && maps==0 && allocs==0;
+        printf("actual presentation mode=%u read=%u map=%u alloc=%u free=%u writes=%u null=%u %s\n",
+            mode,reads,maps,allocs,frees,writes,null_writes,okay?"PASS":"FAIL");
+        if(!okay)failures++;
+    }
+    printf("actual presentation failures=%u\n",failures);return failures?5:0;
+}
diff --git a/developer/debug/test/hidds/virtio-gpu/winsys/virglwinsystest.c b/developer/debug/test/hidds/virtio-gpu/winsys/virglwinsystest.c
