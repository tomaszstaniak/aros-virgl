index 0000000000..8a028f4987
--- /dev/null
+++ b/developer/debug/test/hidds/virtio-gpu/winsys/virglwinsystest.c
@@ -0,0 +1,189 @@
+/* Copyright (C) 2026, The AROS Development Team. All rights reserved. */
+#define VIRGL_WINSYS_FIXTURE 1
+#include "../virgltransport_fixture.h"
+#include "../../../../../../workbench/hidds/virgl/virgl_winsys_aros.c"
+
+static struct Library factory_module;
+static ULONG fixture_format(struct Library *module,ULONG backend,ULONG format)
+{
+    (void)module;
+    return backend==GALLIUM_SCREEN_BACKEND_VIRGL && format==PIPE_FORMAT_B8G8R8A8_UNORM ?
+        VIRGL_FORMAT_B8G8R8A8_UNORM : GALLIUM_SCREEN_FORMAT_INVALID;
+}
+static const struct GalliumScreenFactory factory={
+    .version=GALLIUM_SCREEN_FACTORY_VERSION,.size=sizeof(factory),
+    .module=&factory_module,.backends=GALLIUM_SCREEN_BACKEND_VIRGL,.format=fixture_format
+};
+static struct virgl_hw_res *resource(struct virgl_winsys *ws)
+{
+    return ws->resource_create(ws,PIPE_TEXTURE_2D,NULL,PIPE_FORMAT_B8G8R8A8_UNORM,
+        PIPE_BIND_RENDER_TARGET|PIPE_BIND_SAMPLER_VIEW,4,4,1,1,0,1,0,64);
+}
+static int transfer(struct virgl_winsys *ws,struct virgl_hw_res *r)
+{
+    struct pipe_box box={.width=4,.height=4,.depth=1};
+    return ws->transfer_put(ws,r,&box,16,64,0,0);
+}
+static int normal_lifetime(void)
+{
+    struct virgl_winsys *a=NULL,*b=NULL;
+    fixture_init();a=avgl_winsys_create(&a,&factory,&manager);b=avgl_winsys_create(&b,&factory,&manager);
+    TEST(a && b);TEST(ws_cast(a)->transport.context!=ws_cast(b)->transport.context);
+    struct virgl_hw_res *ra=resource(a),*rb=resource(b);TEST(ra && rb && ra->id!=rb->id);
+    TEST(a->resource_map(a,ra)!=NULL);TEST(transfer(a,ra)==0);TEST(!active_pre && !bad_post);
+    ULONG before=resets;a->resource_reference(a,&ra,NULL);TEST(!ra);
+    a->destroy(a);TEST(!a && manager.references==1 && resets==before);
+    TEST(transfer(b,rb)==0);b->resource_reference(b,&rb,NULL);b->destroy(b);
+    TEST(!b && !manager.device && !live && !wrong_free && !bad_post);return OK;
+}
+static int allocation_failures(void)
+{
+    for(unsigned n=1;n<=5;n++){
+        struct virgl_winsys *a=NULL;
+        fixture_init();fail_allocation=n;a=avgl_winsys_create(&a,&factory,&manager);
+        if(a)a->destroy(a);
+        TEST(!a && !manager.device && !live && !wrong_free);
+    }
+    for(unsigned n=1;n<=3;n++){
+        struct virgl_winsys *a=NULL;
+        fixture_init();a=avgl_winsys_create(&a,&factory,&manager);TEST(a);
+        ULONG baseline=live;fail_allocation=attempts+n;
+        struct virgl_hw_res *r=resource(a);TEST(!r);TEST(live==baseline && !wrong_free);
+        fail_allocation=0;r=resource(a);TEST(r);a->resource_reference(a,&r,NULL);a->destroy(a);
+        TEST(!live && !wrong_free);
+    }
+    return OK;
+}
+static int rejected_resource_stages(void)
+{
+    const ULONG stages[]={GPU_RESOURCE_CREATE_3D,GPU_CTX_ATTACH_RESOURCE,GPU_ATTACH_BACKING};
+    for(unsigned i=0;i<3;i++){
+        struct virgl_winsys *a=NULL,*b=NULL;
+        fixture_init();a=avgl_winsys_create(&a,&factory,&manager);b=avgl_winsys_create(&b,&factory,&manager);TEST(a && b);
+        ULONG baseline=live,before=resets;
+        reject_next=TRUE;reject_type=stages[i];
+        struct virgl_hw_res *r=resource(a);TEST(!r);TEST(live==baseline && resets==before);
+        TEST(command_count[GPU_RESOURCE_CREATE_3D]==1);
+        TEST(command_count[GPU_RESOURCE_UNREF]==(i?1:0));
+        TEST(command_count[GPU_CTX_DETACH_RESOURCE]==(i==2?1:0));
+        r=resource(b);TEST(r && transfer(b,r)==0);b->resource_reference(b,&r,NULL);
+        a->destroy(a);TEST(manager.references==1 && resets==before);b->destroy(b);
+        TEST(!live && !wrong_free && !bad_post);
+    }
+    return OK;
+}
+static int rejected_cleanup_retains_backing(void)
+{
+    struct virgl_winsys *a=NULL,*b=NULL;
+    fixture_init();a=avgl_winsys_create(&a,&factory,&manager);b=avgl_winsys_create(&b,&factory,&manager);TEST(a && b);
+    ULONG baseline=live,before=resets;
+    reject_next=TRUE;reject_type=GPU_CTX_ATTACH_RESOURCE;reject_followup=GPU_RESOURCE_UNREF;
+    struct virgl_hw_res *r=resource(a);ULONG orphan=last_pci_generation;
+    TEST(!r && live==baseline+2 && fixture_generation_live(orphan));
+    a->destroy(a);TEST(fixture_generation_live(orphan) && resets==before);
+    r=resource(b);TEST(r && transfer(b,r)==0);b->resource_reference(b,&r,NULL);b->destroy(b);
+    TEST(!fixture_generation_live(orphan) && !live && !wrong_free && !bad_post);return OK;
+}
+static int short_backing_dma(void)
+{
+    for(unsigned n=0;n<2;n++){
+        struct virgl_winsys *a=NULL;
+        fixture_init();a=avgl_winsys_create(&a,&factory,&manager);TEST(a);
+        struct virgl_hw_res *r=resource(a);TEST(r);
+        if(n==0)fail_pre=pre_attempts+1;else short_pre=pre_attempts+1;
+        TEST(transfer(a,r)==-1);
+        TEST(!active_pre && !bad_post && !avgl_healthy(&ws_cast(a)->transport));
+        fail_pre=short_pre=0;
+        a->resource_reference(a,&r,NULL);a->destroy(a);TEST(!live && !wrong_free);
+    }
+    return OK;
+}
+static int lost_transfer_retains_mapping(void)
+{
+    struct virgl_winsys *a=NULL,*b=NULL;
+    fixture_init();a=avgl_winsys_create(&a,&factory,&manager);b=avgl_winsys_create(&b,&factory,&manager);TEST(a && b);
+    struct virgl_hw_res *r=resource(a);TEST(r);drop_completion=TRUE;
+    TEST(transfer(a,r)==-1);
+    BOOL no_map=a->resource_map(a,r)==NULL;
+    printf("lost transfer: DMAactive=%lu expected=3 badpost=%lu mapdenied=%d\n",
+        (unsigned long)active_pre,(unsigned long)bad_post,no_map);
+    TEST(active_pre==3 && !bad_post && no_map);
+    TEST(!b->fence_wait(b,NULL,0));
+    ULONG before=resets;a->resource_reference(a,&r,NULL);a->destroy(a);TEST(resets==before);
+    fail_reset=TRUE;b->destroy(b);TEST(manager.device && !avgl_manager_can_expunge(&manager));
+    TEST(active_pre==3 && !bad_post && !wrong_free);
+    cleanup();return OK;
+}
+static int fence_allocation_before_publication(void)
+{
+    for(unsigned n=1;n<=2;n++){
+        struct virgl_winsys *a=NULL,*b=NULL;
+        fixture_init();a=avgl_winsys_create(&a,&factory,&manager);
+        b=avgl_winsys_create(&b,&factory,&manager);TEST(a && b);
+        struct virgl_cmd_buf *cb=a->cmd_buf_create(a,4);TEST(cb);
+        struct pipe_fence_handle *f=NULL;
+        cb->buf[0]=0;cb->cdw=1;ULONG before=completed;
+        fail_allocation=attempts+n;
+        TEST(a->submit_cmd(a,cb,&f)==-1);
+        printf("failed fence/scratch allocation %u: publications=%lu expected=0\n",n,(unsigned long)(completed-before));
+        TEST(!f && completed==before && !avgl_healthy(&ws_cast(a)->transport));
+        fail_allocation=0;cb->buf[0]=0;cb->cdw=1;
+        TEST(a->submit_cmd(a,cb,&f)==-1 && !f);
+        TEST(!a->cs_create_fence(a,-1) && !a->fence_wait(a,NULL,0));
+        TEST(avgl_healthy(&ws_cast(b)->transport));
+        a->cmd_buf_destroy(cb);a->destroy(a);b->destroy(b);
+        TEST(!live && !wrong_free && !active_pre);
+    }
+    return OK;
+}
+static int local_failure_cleanup(void)
+{
+    struct virgl_winsys *a=NULL,*b=NULL;
+    fixture_init();a=avgl_winsys_create(&a,&factory,&manager);b=avgl_winsys_create(&b,&factory,&manager);TEST(a && b);
+    struct virgl_hw_res *ra=resource(a);TEST(ra);ULONG own_backing=last_pci_generation;
+    struct virgl_hw_res *rb=resource(b);TEST(rb);
+    struct virgl_cmd_buf *cb=a->cmd_buf_create(a,4);TEST(cb);
+    fail_allocation=attempts+1;a->emit_res(a,cb,ra,true);fail_allocation=0;
+    TEST(a->submit_cmd(a,cb,NULL)==-1);
+    a->cmd_buf_destroy(cb);a->resource_reference(a,&ra,NULL);
+    printf("CPU-only failure backing still live=%d expected=0\n",fixture_generation_live(own_backing));
+    TEST(!fixture_generation_live(own_backing));
+    ULONG before=resets;a->destroy(a);TEST(resets==before && transfer(b,rb)==0);
+    b->resource_reference(b,&rb,NULL);b->destroy(b);TEST(!live && !wrong_free && !bad_post);return OK;
+}
+static int invalid_operations(void)
+{
+    struct virgl_winsys *a=NULL,*b=NULL;
+    fixture_init();a=avgl_winsys_create(&a,&factory,&manager);b=avgl_winsys_create(&b,&factory,&manager);TEST(a && b);
+    ULONG before=completed,baseline=live;
+    TEST(!a->cmd_buf_create(a,0));TEST(!a->cmd_buf_create(a,128*1024+1));
+    TEST(!a->resource_create(a,PIPE_TEXTURE_2D,NULL,PIPE_FORMAT_B8G8R8A8_UNORM,0,4,4,1,1,0,1,0,0));
+    TEST(!a->resource_create(a,PIPE_TEXTURE_2D,NULL,PIPE_FORMAT_NONE,0,4,4,1,1,0,1,0,64));
+    TEST(completed==before && live==baseline);
+    a->destroy(a);
+    for(unsigned n=0;n<3;n++){
+        a=avgl_winsys_create(&a,&factory,&manager);TEST(a);
+        struct virgl_hw_res *r=resource(a);TEST(r);before=completed;
+        struct pipe_box box={.width=4,.height=4,.depth=1};
+        if(n==1)box.x=-1;if(n==2)box.width=0;
+        TEST(a->transfer_put(a,r,&box,16,64,n==0?64:0,0)==-1);
+        TEST(completed==before && !active_pre && !avgl_healthy(&ws_cast(a)->transport));
+        TEST(avgl_healthy(&ws_cast(b)->transport));
+        a->resource_reference(a,&r,NULL);a->destroy(a);
+    }
+    struct virgl_hw_res *peer=resource(b);TEST(peer && transfer(b,peer)==0);
+    b->resource_reference(b,&peer,NULL);b->destroy(b);
+    TEST(!live && !wrong_free && !bad_post);return OK;
+}
+int main(void)
+{
+    int failures=0;
+    int (*cases[])(void)={normal_lifetime,allocation_failures,rejected_resource_stages,
+        rejected_cleanup_retains_backing,short_backing_dma,lost_transfer_retains_mapping,
+        fence_allocation_before_publication,local_failure_cleanup,invalid_operations};
+    for(unsigned i=0;i<sizeof(cases)/sizeof(cases[0]);i++){
+        printf("winsys fault case %u\n",i);fflush(stdout);
+        if(cases[i]()!=OK)failures++;
+    }
+    printf("winsys fault cases: failures=%d\n",failures);return failures?FAIL:OK;
+}
diff --git a/developer/debug/test/library/crtretain.c b/developer/debug/test/library/crtretain.c
new file mode 100644
index 0000000000..13419123dc
--- /dev/null
+++ b/developer/debug/test/library/crtretain.c
@@ -0,0 +1,213 @@
+/* Qualification-only resident library; deliberately mirrors Mesa ownership. */
+#include <libraries/posixc.h>
+#include <proto/posixc.h>
+#include <proto/dos.h>
+#include <dos/var.h>
+#include <aros/symbolsets.h>
+#include <aros/types/file_s.h>
+APTR RetainedPosixC(void)
+{
+    BPTR handle = 0;
+    int mapped = __get_default_file(1, (long *)&handle);
+    FPrintf(Output(), "library: retained=%p fd1=%p output=%p mapped=%ld\n",
+        __aros_getbase_PosixCBase(), (APTR)handle, (APTR)Output(), (LONG)mapped);
+    Flush(Output());
+    return __aros_getbase_PosixCBase();
+}
+
+/* Deterministic regression: fail after genmodule opened relative libraries. */
+static int RejectRequestedOpen(void)
+{
+    char flag[4];
+    return GetVar("AROS_VIRGL_QUAL_FAIL_CRTRETAIN_OPEN", flag, sizeof(flag),
+                  GVF_GLOBAL_ONLY) <= 0;
+}
+ADD2OPENLIB(RejectRequestedOpen, 0);
+
+#include <proto/exec.h>
+#include <proto/stdc.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#include LC_LIBDEFS_FILE
+#include "util/log.h"
+extern FILE *mesa_aros_log_file(void);
+extern FILE *mesa_aros_gallium_log_file(void);
+static int worker_log_marker(const char *token, const char *phase)
+{
+    FILE *a = mesa_aros_log_file(), *b = mesa_aros_gallium_log_file();
+    if (!a || !b) return 1;
+    int error = fprintf(a, "WORKER_LOG[%s:%s]\n", token, phase) <= 0;
+    error |= fflush(a) != 0;
+    error |= fprintf(b, "WORKER_LOG[%s:%s]\n", token, phase) <= 0;
+    error |= fflush(b) != 0;
+    return error;
+}
+struct LogStress {
+    const char *token;
+    int id;
+    int *go;
+};
+static void *log_stress(void *arg)
+{
+    struct LogStress *x = arg;
+    char payload[257], message[512];
+    int i;
+    memset(payload, 'A' + x->id, 256); payload[256] = 0;
+    while (!__atomic_load_n(x->go, __ATOMIC_ACQUIRE)) Delay(1);
+    for (i = 0; i < 64; ++i) {
+        snprintf(message, sizeof(message), "WORKER_PAR[%s:%d:%02d:%s]", x->token, x->id, i, payload);
+        mesa_log(MESA_LOG_ERROR, "QUAL", "%s", message);
+        FILE *gallium = mesa_aros_gallium_log_file();
+        if (!gallium || fputs(message, gallium) < 0 || fputs("\n", gallium) < 0 || fflush(gallium)) return (void *)1;
+    }
+    return NULL;
+}
+static int parallel_log_markers(const char *token)
+{
+    pthread_t threads[2];
+    int go = 0, n = 0, error = 0, i;
+    struct LogStress args[2] = {{token, 0, &go}, {token, 1, &go}};
+    for (i = 0; i < 2; ++i) {
+        if (pthread_create(&threads[i], NULL, log_stress, &args[i])) { error = 1; break; }
+        ++n;
+    }
+    __atomic_store_n(&go, 1, __ATOMIC_RELEASE);
+    for (i = 0; i < n; ++i) {
+        void *result = (void *)1;
+        if (pthread_join(threads[i], &result) || result) error = 1;
+    }
+    return error;
+}
+static pthread_key_t marker_key;
+static int destructors, destructor_errors;
+static void marker_destructor(void *arg)
+{
+    ++destructors;
+    if (!__aros_getoffsettable() ||
+        printf("STDIO_TLS[%s]\n", (char *)arg) <= 0 || fflush(stdout) != 0)
+        ++destructor_errors;
+}
+static void *nested_marker(void *arg)
+{
+    if (pthread_setspecific(marker_key, arg)) return (void *)1;
+    int error = worker_log_marker(arg, "nested");
+    if (printf("STDIO_NESTED[%s]\n", (char *)arg) <= 0 || fflush(stdout)) error = 1;
+    return (void *)(IPTR)error;
+}
+static void *worker_marker(void *arg)
+{
+    /* A native check fails gracefully before touching an unbound module CRT. */
+    if (!__aros_getoffsettable()) return (void *)1;
+    if (pthread_setspecific(marker_key, arg)) return (void *)1;
+    if (!strncmp(arg, "worker-log-", 11) && worker_log_marker(arg, "worker")) return (void *)1;
+    int n = printf("STDIO_CLIENT[%s]\n", (char *)arg);
+    int f = fflush(stdout);
+    int error = n <= 0 || f != 0;
+    if (!strncmp(arg, "worker-log-nested-", 18)) {
+        pthread_t nested;
+        void *result = (void *)1;
+        if (pthread_create(&nested, NULL, nested_marker, arg)) error = 1;
+        else if (pthread_join(nested, &result) || result) error = 1;
+    }
+    if (!strncmp(arg, "worker-exit-", 12)) pthread_exit((void *)(IPTR)error);
+    return (void *)(IPTR)error;
+}
+/* Native ownership keeps the negative-control tokens recoverable at expunge. */
+#include <exec/memory.h>
+#include <exec/semaphores.h>
+struct client_token {struct client_token *next;char text[96];};
+static struct client_token *client_tokens;
+static struct SignalSemaphore client_token_lock;
+static pthread_once_t client_once=PTHREAD_ONCE_INIT;
+static pthread_key_t client_key;
+static int client_key_error;
+static int ClientTokenInit(void){InitSemaphore(&client_token_lock);return TRUE;}
+static void ClientTokenExit(void)
+{while(client_tokens){struct client_token *t=client_tokens;client_tokens=t->next;FreeVec(t);}}
+ADD2INIT(ClientTokenInit,-10);
+ADD2EXIT(ClientTokenExit,-200);
+static void client_tls_destructor(void *arg)
+{
+    struct client_token *t=arg,**link;
+    printf("STDIO_CLIENT_TLS[%s]\n",t->text);fflush(stdout);
+    ObtainSemaphore(&client_token_lock);link=&client_tokens;
+    while(*link && *link!=t)link=&(*link)->next;
+    if(*link)*link=t->next;
+    ReleaseSemaphore(&client_token_lock);FreeVec(t);
+}
+static void ClientKeyInit(void){client_key_error=pthread_key_create(&client_key,client_tls_destructor);}
+static int register_client_tls(const char *token)
+{
+    pthread_once(&client_once,ClientKeyInit);
+    if(client_key_error || pthread_getspecific(client_key))return 1;
+    struct client_token *t=AllocVec(sizeof(*t),MEMF_ANY|MEMF_CLEAR);if(!t)return 1;
+    snprintf(t->text,sizeof(t->text),"%s",token);
+    ObtainSemaphore(&client_token_lock);t->next=client_tokens;client_tokens=t;ReleaseSemaphore(&client_token_lock);
+    if(pthread_setspecific(client_key,t))return 1;
+    return printf("STDIO_CLIENT[%s]\n",token)<=0 || fflush(stdout)!=0;
+}
+LONG WriteWorkerMarker(CONST_STRPTR token)
+{
+    if(!strncmp(token,"client-tls-",11))return register_client_tls(token);
+    pthread_t thread;
+    void *result = (void *)1;
+    int tls_fail = strncmp(token,"worker-tls-fail-",16)==0;
+    int fail = tls_fail || strncmp(token, "worker-fail-", 12) == 0;
+    const char *fail_flag=tls_fail?"AROS_VIRGL_QUAL_FAIL_TLS_ALLOC":"AROS_VIRGL_QUAL_FAIL_CRTRETAIN_OPEN";
+    int error;
+    thread = (pthread_t)~0U;
+    destructors = destructor_errors = 0;
+    if (pthread_key_create(&marker_key, marker_destructor)) return 1;
+    if (fail && !SetVar(fail_flag, "1", 1, GVF_GLOBAL_ONLY)) {
+        pthread_key_delete(marker_key);
+        return 1;
+    }
+    if (!strncmp(token, "worker-log-", 11) && worker_log_marker(token, "before")) {
+        pthread_key_delete(marker_key); return 1;
+    }
+    error = pthread_create(&thread, NULL, worker_marker, (void *)token);
+    if (fail) {
+        if(tls_fail)DeleteFile("ENV:AROS_VIRGL_QUAL_FAIL_TLS_ALLOC");
+        else DeleteVar(fail_flag, GVF_GLOBAL_ONLY);
+        /* A negative control must join an unexpectedly successful worker. */
+        if(!error){pthread_join(thread,&result);pthread_key_delete(marker_key);return 1;}
+        pthread_key_delete(marker_key);
+        if (destructors || destructor_errors) return 1;
+        if (error != EAGAIN || thread != (pthread_t)~0U) return 1;
+        if (printf("STDIO_CLIENT[%s]\n", token) <= 0 || fflush(stdout) != 0) return 1;
+        return 0;
+    }
+    if (error) { pthread_key_delete(marker_key); return error; }
+    error = pthread_join(thread, &result);
+    pthread_key_delete(marker_key);
+    if (destructors != (!strncmp(token, "worker-log-nested-", 18) ? 2 : 1) || destructor_errors) return 1;
+    if (!strncmp(token, "worker-log-", 11) && worker_log_marker(token, "after")) return 1;
+    if (!strncmp(token, "worker-log-parallel-", 20) && parallel_log_markers(token)) return 1;
+    return error ? error : (LONG)(IPTR)result;
+}
+
+static int RejectRequestedInit(void)
+{
+    char flag[4];
+    return GetVar("AROS_VIRGL_QUAL_FAIL_CRTRETAIN_INIT", flag, sizeof(flag),
+                  GVF_GLOBAL_ONLY) <= 0;
+}
+ADD2INIT(RejectRequestedInit, -90);
+
+/* Native diagnostic callback; caller must hold a module code pin while it
+ * invokes the getter after closing its task-local client opening. */
+APTR ModuleTableGetter(void)
+{
+    return (APTR)__aros_getoffsettable;
+}
+
+/* Keep native diagnostic code resident until the test explicitly lifts veto. */
+static int RejectRequestedExpunge(void)
+{
+    char flag[4];
+    return GetVar("AROS_VIRGL_QUAL_FAIL_CRTRETAIN_EXPUNGE", flag, sizeof(flag),
+                  GVF_GLOBAL_ONLY) <= 0;
+}
+ADD2EXPUNGELIB(RejectRequestedExpunge, 90);
