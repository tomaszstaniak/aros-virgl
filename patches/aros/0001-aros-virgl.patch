diff --git a/developer/debug/test/hidds/virtio-gpu/galliumfallbacktest.c b/developer/debug/test/hidds/virtio-gpu/galliumfallbacktest.c
new file mode 100644
index 0000000000..5bda4b1716
--- /dev/null
+++ b/developer/debug/test/hidds/virtio-gpu/galliumfallbacktest.c
@@ -0,0 +1,120 @@
+/* Copyright (C) 2026, The AROS Development Team. All rights reserved. */
+/* The actual CreatePipe body, with a blocked module loader and no real HIDD.
+ * Both callers must reach their blocking point before the loader is released. */
+#include <exec/execbase.h>
+#include <exec/tasks.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/utility.h>
+#include <proto/intuition.h>
+#include <aros/debug.h>
+#include <hidd/gfx.h>
+#include "../../../../../workbench/libs/gallium/gallium_intern.h"
+#include "../../crt/test.h"
+
+struct worker {
+    struct Task *task;
+    ULONG id;
+    BOOL created,started,returned;
+    PipeHandle_t pipe;
+};
+static struct worker workers[2];
+static struct GalliumBase base;
+static struct Library module;
+static ULONG opens,pins;
+#define LOADER_GATE SIGBREAKF_CTRL_F
+#define EXIT_GATE SIGBREAKF_CTRL_E
+static struct Library *blocked_open(CONST_STRPTR name,ULONG version)
+{
+    (void)name;(void)version;
+    __atomic_add_fetch(&opens,1,__ATOMIC_SEQ_CST);
+    __atomic_add_fetch(&pins,1,__ATOMIC_SEQ_CST);
+    Wait(LOADER_GATE);
+    return &module;
+}
+static IPTR fixture_tag(Tag tag,IPTR default_value,const struct TagItem *tags)
+{
+    while(tags->ti_Tag!=TAG_DONE){if(tags->ti_Tag==tag)return tags->ti_Data;tags++;}
+    return default_value;
+}
+#undef AROS_LH1
+#undef AROS_LHA
+#undef AROS_LIBFUNC_INIT
+#undef AROS_LIBFUNC_EXIT
+#define AROS_LHA(type,name,reg) type name
+#define AROS_LH1(ret,name,arg,base_type,base_name,lvo,lib) static ret fixture_create(arg,base_type base_name)
+#define AROS_LIBFUNC_INIT
+#define AROS_LIBFUNC_EXIT
+#undef GetTagData
+#undef OpenLibrary
+#undef LockPubScreen
+#undef UnlockPubScreen
+#undef OOP_GetAttr
+#undef OOP_NewObject
+#undef HIDD_Display_CreateObject
+#define GetTagData(tag,value,tags) fixture_tag(tag,value,tags)
+#define OpenLibrary(name,version) blocked_open(name,version)
+#define LockPubScreen(name) NULL
+#define UnlockPubScreen(name,screen) ((void)(screen))
+#define OOP_GetAttr(object,id,out) (*(out)=0)
+#define OOP_NewObject(class,id,tags) ((OOP_Object*)&module)
+#define HIDD_Display_CreateObject(display,class,tags) ((OOP_Object*)&module)
+#include "../../../../../workbench/libs/gallium/createpipe.c"
+
+static LONG worker_entry(void)
+{
+    struct worker *w=FindTask(NULL)->tc_UserData;
+    struct TagItem tags[]={{CPS_GalliumInterfaceVersion,GALLIUM_INTERFACE_VERSION},{TAG_DONE,0}};
+    SetSignal(0,LOADER_GATE|EXIT_GATE);
+    w->task=FindTask(NULL);w->id=GetETask(w->task)->et_UniqueID;
+    __atomic_store_n(&w->started,TRUE,__ATOMIC_RELEASE);
+    w->pipe=fixture_create(tags,(struct Library*)&base);
+    __atomic_store_n(&w->returned,TRUE,__ATOMIC_RELEASE);
+    /* Keep Task pointers and this entry code valid until the parent joins. */
+    Wait(EXIT_GATE);
+    return 0;
+}
+static BOOL wait_blocked(struct worker *w)
+{
+    for(unsigned n=0;n<1000;n++){
+        if(__atomic_load_n(&w->started,__ATOMIC_ACQUIRE) &&
+            __atomic_load_n(&w->task->tc_State,__ATOMIC_ACQUIRE)==TS_WAIT)
+            return !__atomic_load_n(&w->returned,__ATOMIC_ACQUIRE);
+        Delay(1);
+    }
+    return FALSE;
+}
+void cleanup(void)
+{
+    for(unsigned i=0;i<2;i++)if(workers[i].created){
+        while(!__atomic_load_n(&workers[i].started,__ATOMIC_ACQUIRE))Delay(1);
+        Signal(workers[i].task,LOADER_GATE|EXIT_GATE);
+    }
+    for(unsigned i=0;i<2;i++)if(workers[i].created){
+        ChildWait(workers[i].id);ChildFree(workers[i].id);workers[i].created=FALSE;
+    }
+    if(base.fallbackmodule){
+        __atomic_sub_fetch(&pins,1,__ATOMIC_SEQ_CST);base.fallbackmodule=NULL;
+    }
+    printf("fallback cleanup: module opens=%lu retained pins=%lu\n",(unsigned long)opens,(unsigned long)pins);
+}
+int main(void)
+{
+    base.fallback="fixture";
+    InitSemaphore(&base.fallbackLock);
+    for(unsigned i=0;i<2;i++){
+        struct Process *child=CreateNewProcTags(NP_Entry,(IPTR)worker_entry,
+            NP_Name,(IPTR)"fallback first opener",NP_StackSize,131072,
+            NP_UserData,(IPTR)&workers[i],NP_NotifyOnDeath,TRUE,TAG_DONE);
+        TEST(child!=NULL);workers[i].created=TRUE;
+        TEST(wait_blocked(&workers[i]));
+    }
+    ULONG count=__atomic_load_n(&opens,__ATOMIC_SEQ_CST);
+    printf("both first callers blocked: opens=%lu expected=1\n",(unsigned long)count);
+    TEST(count==1);
+    cleanup();
+    TEST(workers[0].pipe && workers[1].pipe);
+    TEST(opens==1 && pins==0);
+    puts("concurrent first fallback ownership: PASS");
+    return OK;
+}
