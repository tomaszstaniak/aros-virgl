+static void say(char *text, const char *what, ULONG type, ULONG seconds)
+{
+    static const char hex[] = "0123456789abcdef";
+    char digits[12];
+    ULONG n = 0, d = 0;
+    while (*what) text[n++] = *what++;
+    text[n++] = hex[(type >> 8) & 15]; text[n++] = hex[(type >> 4) & 15]; text[n++] = hex[type & 15];
+    text[n++] = ','; text[n++] = ' ';
+    do { digits[d++] = '0' + seconds % 10; seconds /= 10; } while (seconds);
+    while (d) text[n++] = digits[--d];
+    text[n++] = ' '; text[n++] = 's'; text[n++] = ')'; text[n] = 0;
+}
+/* Waits until the host has answered the published command. Watches the ring
+ * for a short while first: the host usually answers within microseconds and
+ * a timer tick is 20 ms. FALSE: no answer within limit_ms. */
+static BOOL answered(struct avgl_device *s)
+{
+    struct EClockVal v;
+    __sync_synchronize();
+    if (s->used->idx == s->last_used) return FALSE;
+    if (s->hold_from && TimerBase &&
+        (eclock_now() - s->hold_from) * 1000 / ReadEClock(&v) < s->hold_ms) return FALSE;
+    return TRUE;
+}
+static BOOL wait_answer(struct avgl_device *s, ULONG type, ULONG limit_ms)
+{
+    struct EClockVal v;
+    UQUAD start = 0, rate = 0, waited_ms = 0;
+    ULONG i, ticks = 0;
+    BOOL told = FALSE;
+    char text[96];
+    if (TimerBase) {
+        rate = ReadEClock(&v);
+        start = ((UQUAD)v.ev_hi << 32) | v.ev_lo;
+        for (i = 0;; i++) {
+            if (answered(s)) return TRUE;
+            if ((i & 255) == 0) {
+                waited_ms = (eclock_now() - start) * 1000 / rate;
+                if (waited_ms >= SPIN_MS || waited_ms >= limit_ms) break;
+            }
+        }
+    }
+    for (;;) {
+        if (answered(s)) break;
+        waited_ms = TimerBase ? (eclock_now() - start) * 1000 / rate : (UQUAD)ticks * 20;
+        if (waited_ms >= limit_ms) {
+            say(text, "virgl: stopped, the host did not answer (command 0x", type, (ULONG)(waited_ms / 1000));
+            avgl_report(text);
+            return FALSE;
+        }
+        if (!told && waited_ms >= NOTICE_MS) {
+            told = TRUE;
+            say(text, "virgl: waiting for the host (command 0x", type, (ULONG)(waited_ms / 1000));
+            avgl_report(text);
+            bug("[virgl] host slow: command 0x%lx waits for more than %lu ms\n",
+                (unsigned long)type, (unsigned long)waited_ms);
+        }
+        Delay(1); ticks++;
+    }
+    if (told) avgl_report("virgl");
+    return TRUE;
+}
+/* Takes the answer of a command that an earlier caller gave up on. */
+static BOOL settle_stale(struct avgl_device *s, ULONG limit_ms)
+{
+    if (!wait_answer(s, s->stale_type, limit_ms)) return FALSE;
+    __sync_synchronize();
+    if (s->used->idx != (UWORD)(s->last_used + 1) ||
+        s->used->ring[s->last_used % QUEUE_SIZE].id != 0) { s->failed = TRUE; return FALSE; }
+    s->last_used++;
+    finish_queue_dma(s);
+    (void)*s->isr;
+    s->stale = FALSE; s->hold_from = 0; s->hold_ms = 0;
+    bug("[virgl] late answer to command 0x%lx taken; the card works again\n",
+        (unsigned long)s->stale_type);
+    return TRUE;
+}
