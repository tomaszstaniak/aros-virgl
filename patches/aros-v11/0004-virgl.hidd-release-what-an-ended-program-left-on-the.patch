+/* How long the host may take over one command before the caller gives up.
+ * A drawing command can make the host compile shaders, which takes seconds
+ * on a slow machine; nothing else is expected to take long. Giving up ends
+ * the calling program's OpenGL, so the limits are generous. */
+#define WAIT_SUBMIT_MS 120000
+#define WAIT_OTHER_MS 30000
+/* After this long the user is told that the host is slow. */
+#define NOTICE_MS 3000
 /* How long to watch the ring before sleeping. A timer tick is 20 ms, so a
  * reply that misses a short spin costs a whole tick; a full-screen readback
  * on the host can take a few milliseconds. */
 #define SPIN_MS 100
+void avgl_report(const char *status);
